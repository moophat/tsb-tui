          "type": "ssh",
          "name": "Core Router 20",
          "options": {
            "host": "10.0.1.20",
            "port": 22,
            "user": "admin",
            "login_timeout": 120
          }
        },
        "note": "options.login_timeout 120: this target's own bound, integer seconds"
