{
  "seam": "C3",
  "name": "linger-close",
  "mark": {
    "required-green": "e1"
  },
  "kind": "sequence",
  "grade": "artifacts:control-linger",
  "description": "connection_linger (session model §11): when a connection's last session ends, the worker keeps the connection up for connection_linger, so that a quick reopen reuses the login (§5; a TACACS+ round trip saved), then closes it: connection_lost cause linger, listing no session. A retained ended session is not listed and is not a session for the linger. A v0.1 core reads the unknown cause as transport, and the event lists no session for it to end.",
  "corpus": [
    "session model §5",
    "session model §11",
    "lang-arch §6.4"
  ],
  "case": {
    "socket": "conn-control",
    "messages": [
      {
        "from": "core",
        "msg": {
          "cmd": "connect",
          "target_id": "fixture-target",
          "protocol": "ssh",
          "host": "192.0.2.10",
          "port": 22,
          "user": "fixture-user",
          "auth": {
            "kind": "key",
            "key": "FIXTURE-NOT-A-KEY"
          },
          "timers": {
            "heartbeat_interval": 10000,
            "heartbeat_missed": 3,
            "keepalive_interval": 30000,
            "keepalive_count_max": 12,
            "connection_linger": 300000,
            "orphan_timeout": 172800000,
            "idle": 604800000,
            "unattended": 2592000000
          },
          "buffer_bytes": 8388608,
          "input_frame_max": 1048576
        }
      },
      {
        "from": "worker",
        "msg": {
          "event": "connected",
          "conn_id": "fixture-conn-1"
        }
      },
      {
        "from": "core",
        "msg": {
          "cmd": "open_shell",
          "session_id": "fixture-session-a",
          "term": "xterm-256color",
          "cols": 120,
          "rows": 40
        }
      },
      {
        "from": "worker",
        "msg": {
          "event": "channel_opened",
          "session_id": "fixture-session-a",
          "session_type": "shell",
          "socket": "shell.sock"
        }
      },
      {
        "from": "core",
        "msg": {
          "cmd": "hello",
          "session_id": "fixture-session-a",
          "proto_version": "0.2",
          "last_committed_seq": 0
        },
        "note": "the core dialled the data socket first; nothing is committed yet"
      },
      {
        "from": "worker",
        "msg": {
          "event": "hello_ack",
          "session_id": "fixture-session-a",
          "proto_version": "0.2",
          "first_buffered_seq": 1,
          "first_buffered_offset": 0,
          "current_seq": 0,
          "ended": false
        },
        "note": "nothing buffered and no output yet: first_buffered_seq is current_seq + 1"
      },
      {
        "from": "core",
        "msg": {
          "cmd": "replay",
          "session_id": "fixture-session-a",
          "from_seq": 1
        }
      },
      {
        "from": "worker",
        "msg": {
          "event": "replay_done",
          "session_id": "fixture-session-a",
          "through_seq": 0
        },
        "note": "through_seq 0 < from_seq 1: complete with no frame"
      },
      {
        "from": "core",
        "msg": {
          "cmd": "live",
          "session_id": "fixture-session-a"
        },
        "note": "only now is the session offered northbound (the 201)"
      },
      {
        "from": "core",
        "msg": {
          "cmd": "close_channel",
          "session_id": "fixture-session-a"
        }
      },
      {
        "from": "worker",
        "msg": {
          "event": "channel_closed",
          "session_id": "fixture-session-a",
          "by": "core",
          "reason": "closed by the core"
        }
      },
      {
        "from": "core",
        "msg": {
          "cmd": "release",
          "session_id": "fixture-session-a"
        },
        "note": "recorded to its end"
      },
      {
        "from": "worker",
        "msg": {
          "event": "connection_lost",
          "conn_id": "fixture-conn-1",
          "session_ids": [],
          "cause": "linger",
          "reason": "connection_linger ran out"
        }
      }
    ]
  }
}
