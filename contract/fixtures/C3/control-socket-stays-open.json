      "unit": "U2",
      "test": "core/internal/session/redial_control_test.go — TestEveryControlEOFDialsOnceHoweverSoonAfterTheLast: on a control-socket EOF with no connection_lost the core dials control.sock once; if the worker answers it ends nothing, and only a refused or missing socket is E9"
    }
