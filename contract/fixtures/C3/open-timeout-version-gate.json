{
  "seam": "C3",
  "name": "open-timeout-version-gate",
  "mark": {
    "published": "e3",
    "required-green": "e4"
  },
  "kind": "sequence",
  "grade": "artifacts:control-open-timeout",
  "description": "The version gate on open_shell's open_timeout (V1; immortality §6.4: additive only, and the core speaks N and N-1). The core speaks 0.6, 0.5, 0.4, 0.3 and 0.2 and sends a peer only the keys its version knows: toward a worker at proto_version 0.6 or later every open_shell carries open_timeout, the bound in force for the target (config.yaml worker.open_timeout, or the target's options.open_timeout); toward a worker below 0.6 none does, and that worker waits for the target as before. This sequence is the 0.6 half: an open_shell carrying the bound, then the new session's handshake in 0.6. control-open-timeout grades the field's presence toward ≥ 0.6 peers and its absence toward older ones, from the peer's version in its manifest or worker_created.",
  "corpus": [
    "immortality §6.4",
    "decision 5.36",
    "lang-arch §7.3",
    "plan.md §3 C3",
    "CHANGELOG v0.3 D29"
  ],
  "case": {
    "socket": "conn-control",
    "messages": [
      {
        "from": "core",
        "msg": {
          "cmd": "connect",
          "target_id": "fixture-target",
          "protocol": "ssh",
          "host": "192.0.2.10",
          "port": 22,
          "user": "fixture-user",
          "auth": {
            "kind": "key",
            "key": "FIXTURE-NOT-A-KEY"
          },
          "timers": {
            "heartbeat_interval": 10000,
            "heartbeat_missed": 3,
            "keepalive_interval": 30000,
            "keepalive_count_max": 12,
            "connection_linger": 300000,
            "orphan_timeout": 172800000,
            "idle": 604800000,
            "unattended": 2592000000,
            "keepalive_probe_interval": 15000
          },
          "buffer_bytes": 8388608,
          "input_frame_max": 1048576
        }
      },
      {
        "from": "worker",
        "msg": {
          "event": "connected",
          "conn_id": "fixture-conn-1"
        }
      },
      {
        "from": "core",
        "msg": {
          "cmd": "open_shell",
          "session_id": "fixture-session-a",
          "term": "xterm-256color",
          "cols": 80,
          "rows": 24,
          "open_timeout": 20000
        },
        "note": "toward a 0.6 worker the bound rides every open_shell; toward 0.5 or older it is absent"
      },
      {
        "from": "worker",
        "msg": {
          "event": "channel_opened",
          "session_id": "fixture-session-a",
          "session_type": "shell",
          "socket": "shell.sock"
        },
        "note": "within the bound"
      },
      {
        "from": "core",
        "msg": {
          "cmd": "hello",
          "session_id": "fixture-session-a",
          "proto_version": "0.6",
          "last_committed_seq": 0
        }
      },
      {
        "from": "worker",
        "msg": {
          "event": "hello_ack",
          "session_id": "fixture-session-a",
          "proto_version": "0.6",
          "first_buffered_seq": 1,
          "first_buffered_offset": 0,
          "current_seq": 0,
          "ended": false
        }
      },
      {
        "from": "core",
        "msg": {
          "cmd": "replay",
          "session_id": "fixture-session-a",
          "from_seq": 1
        }
      },
      {
        "from": "worker",
        "msg": {
          "event": "replay_done",
          "session_id": "fixture-session-a",
          "through_seq": 0
        }
      },
      {
        "from": "core",
        "msg": {
          "cmd": "live",
          "session_id": "fixture-session-a"
        }
      }
    ]
  }
}
