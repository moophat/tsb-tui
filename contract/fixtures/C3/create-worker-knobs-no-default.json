        "doc": {
          "cmd": "create_worker",
          "conn_id": "fixture-conn-1",
          "placement_key": "fixture-user",
          "n_max": 4
        },
        "note": "a v0.1 request: no bound, and none assumed"
      },
      {
        "valid": true,
        "doc": {
          "cmd": "create_worker",
          "conn_id": "fixture-conn-1",
          "placement_key": "fixture-user",
          "n_max": 4,
          "undialled_timeout": 60000
        }
      },
      {
        "valid": false,
