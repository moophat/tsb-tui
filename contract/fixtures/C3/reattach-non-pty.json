        "note": "nothing buffered and no output yet: first_buffered_seq is current_seq + 1"
      },
      {
        "from": "core",
        "msg": {
          "cmd": "replay",
          "session_id": "fixture-session-b",
          "from_seq": 1
        }
      },
      {
        "from": "worker",
        "msg": {
          "event": "replay_done",
          "session_id": "fixture-session-b",
          "through_seq": 0
