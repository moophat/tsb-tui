          "event": "hello_ack",
          "session_id": "fixture-session-b",
          "proto_version": "0.2",
          "first_buffered_seq": 41,
          "first_buffered_offset": 9000,
          "current_seq": 40,
          "ended": false
        },
        "note": "no ring: nothing buffered, nothing lost"
      },
      {
        "from": "core",
        "msg": {
          "cmd": "replay",
          "session_id": "fixture-session-b",
          "from_seq": 41
        }
      },
      {
        "from": "worker",
        "msg": {
          "event": "replay_done",
