{
  "seam": "C3",
  "name": "device-login-version-gate",
  "mark": {
    "published": "e3",
    "required-green": "e5"
  },
  "kind": "sequence",
  "grade": "reference",
  "graded_by": [
    {
      "unit": "U2",
      "test": "core/internal/worker/control_test.go — TestNoDeviceLoginMessageGoesToAWorkerBelow07"
    }
  ],
  "description": "The version gate on the device-login messages (V1; immortality §6.4: additive only, the core speaks N and N-1). The core sends a prompt-mode `connect`, `hostkey_answer` and `auth_answer` only to a peer at proto_version 0.7 or later, and with it `login_timeout`; toward an older worker none of them is sent, and a prompt-mode create is refused 503 before anything is placed (C1/session-create-device-login-needs-v0.7-503). This sequence is the 0.7 half: a prompt-mode connect, its answer, and the new session's handshake in 0.7.",
  "corpus": [
    "immortality §6.4",
    "device-login steps 6, 10",
    "ipc-control version paragraph"
  ],
  "case": {
    "socket": "conn-control",
    "messages": [
      {
        "from": "core",
        "msg": {
          "cmd": "connect",
          "target_id": "fixture-target",
          "protocol": "ssh",
          "host": "192.0.2.10",
          "port": 22,
          "user": "fixture-account",
          "auth": {
            "kind": "prompt"
          },
          "login_timeout": 120000,
          "timers": {
            "heartbeat_interval": 10000,
            "heartbeat_missed": 3,
            "keepalive_interval": 4000,
            "keepalive_count_max": 2,
            "keepalive_probe_interval": 1500,
            "connection_linger": 30000,
            "orphan_timeout": 60000,
            "idle": 900000,
            "unattended": 1800000
          },
          "buffer_bytes": 65536,
          "input_frame_max": 4096
        },
        "note": "toward a 0.7 worker; toward 0.6 or older it is never sent"
      },
      {
        "from": "worker",
        "msg": {
          "event": "auth_prompt",
          "conn_id": "fixture-conn-1",
          "method": "password",
          "attempt": 1,
          "prompt_id": 1
        }
      },
      {
        "from": "core",
        "msg": {
          "cmd": "auth_answer",
          "prompt_id": 1,
          "answers": [
            "FIXTURE-NOT-A-PASSWORD"
          ]
        }
      },
      {
        "from": "worker",
        "msg": {
          "event": "connected",
          "conn_id": "fixture-conn-1"
        }
      },
      {
        "from": "core",
        "msg": {
          "cmd": "open_shell",
          "session_id": "fixture-session-a",
          "term": "xterm-256color",
          "cols": 120,
          "rows": 40,
          "open_timeout": 20000
        }
      },
      {
        "from": "worker",
        "msg": {
          "event": "channel_opened",
          "session_id": "fixture-session-a",
          "session_type": "shell",
          "socket": "shell.sock"
        }
      },
      {
        "from": "core",
        "msg": {
          "cmd": "hello",
          "session_id": "fixture-session-a",
          "proto_version": "0.7",
          "last_committed_seq": 0
        }
      },
      {
        "from": "worker",
        "msg": {
          "event": "hello_ack",
          "session_id": "fixture-session-a",
          "proto_version": "0.7",
          "first_buffered_seq": 1,
          "first_buffered_offset": 0,
          "current_seq": 0,
          "ended": false
        }
      },
      {
        "from": "core",
        "msg": {
          "cmd": "replay",
          "session_id": "fixture-session-a",
          "from_seq": 1
        }
      },
      {
        "from": "worker",
        "msg": {
          "event": "replay_done",
          "session_id": "fixture-session-a",
          "through_seq": 0
        }
      },
      {
        "from": "core",
        "msg": {
          "cmd": "live",
          "session_id": "fixture-session-a"
        }
      }
    ]
  }
}
