{
  "seam": "C3",
  "name": "hello-no-data-peer",
  "mark": {
    "required-green": "e1"
  },
  "kind": "sequence",
  "grade": "reference",
  "graded_by": [
    {
      "unit": "U3",
      "test": "worker/tests/test_reattach.py — a hello with no new data peer within heartbeat_interval is answered error no_data_peer naming the session"
    }
  ],
  "description": "The worker answers hello only on a data peer accepted after the previous one ended, and waits for one at most heartbeat_interval — the value the core sent, no knob of its own — then answers error no_data_peer, naming the session, so a core that failed to dial is told instead of left waiting.",
  "corpus": [
    "immortality §6.1",
    "session model §11"
  ],
  "case": {
    "socket": "conn-control",
    "messages": [
      {
        "from": "core",
        "msg": {
          "cmd": "connect",
          "target_id": "fixture-target",
          "protocol": "ssh",
          "host": "192.0.2.10",
          "port": 22,
          "user": "fixture-user",
          "auth": {
            "kind": "key",
            "key": "FIXTURE-NOT-A-KEY"
          },
          "timers": {
            "heartbeat_interval": 10000,
            "heartbeat_missed": 3,
            "keepalive_interval": 30000,
            "keepalive_count_max": 12,
            "connection_linger": 300000,
            "orphan_timeout": 172800000,
            "idle": 604800000,
            "unattended": 2592000000
          },
          "buffer_bytes": 8388608,
          "input_frame_max": 1048576
        }
      },
      {
        "from": "worker",
        "msg": {
          "event": "connected",
          "conn_id": "fixture-conn-1"
        }
      },
      {
        "from": "core",
        "msg": {
          "cmd": "open_shell",
          "session_id": "fixture-session-a",
          "term": "xterm-256color",
          "cols": 120,
          "rows": 40
        }
      },
      {
        "from": "worker",
        "msg": {
          "event": "channel_opened",
          "session_id": "fixture-session-a",
          "session_type": "shell",
          "socket": "shell.sock"
        }
      },
      {
        "from": "core",
        "msg": {
          "cmd": "hello",
          "session_id": "fixture-session-a",
          "proto_version": "0.2",
          "last_committed_seq": 0
        },
        "note": "the core dialled the data socket first; nothing is committed yet"
      },
      {
        "from": "worker",
        "msg": {
          "event": "hello_ack",
          "session_id": "fixture-session-a",
          "proto_version": "0.2",
          "first_buffered_seq": 1,
          "first_buffered_offset": 0,
          "current_seq": 0,
          "ended": false
        },
        "note": "nothing buffered and no output yet: first_buffered_seq is current_seq + 1"
      },
      {
        "from": "core",
        "msg": {
          "cmd": "replay",
          "session_id": "fixture-session-a",
          "from_seq": 1
        }
      },
      {
        "from": "worker",
        "msg": {
          "event": "replay_done",
          "session_id": "fixture-session-a",
          "through_seq": 0
        },
        "note": "through_seq 0 < from_seq 1: complete with no frame"
      },
      {
        "from": "core",
        "msg": {
          "cmd": "live",
          "session_id": "fixture-session-a"
        },
        "note": "only now is the session offered northbound (the 201)"
      },
      {
        "from": "core",
        "msg": {
          "cmd": "hello",
          "session_id": "fixture-session-a",
          "proto_version": "0.2",
          "last_committed_seq": 12
        },
        "note": "the core's dial of the data socket failed"
      },
      {
        "from": "worker",
        "msg": {
          "event": "error",
          "code": "no_data_peer",
          "session_id": "fixture-session-a",
          "message": "no new data peer within heartbeat_interval"
        }
      }
    ]
  }
}
