{
  "seam": "C3",
  "name": "input-refused-ended",
  "mark": {
    "required-green": "e1"
  },
  "kind": "sequence",
  "grade": "reference",
  "graded_by": [
    {
      "unit": "U3",
      "test": "worker/tests/test_worker.py — an input frame for an ended channel is not delivered and is answered input_refused ended"
    }
  ],
  "description": "An input frame for a session whose channel has ended is not delivered and is answered input_refused ended, named by its seq: error is a command's failure, and a data frame is not a command. The worker counts and logs it as at E0.",
  "corpus": [
    "session model §13",
    "decision 5.44"
  ],
  "case": {
    "socket": "conn-control",
    "messages": [
      {
        "from": "core",
        "msg": {
          "cmd": "connect",
          "target_id": "fixture-target",
          "protocol": "ssh",
          "host": "192.0.2.10",
          "port": 22,
          "user": "fixture-user",
          "auth": {
            "kind": "key",
            "key": "FIXTURE-NOT-A-KEY"
          },
          "timers": {
            "heartbeat_interval": 10000,
            "heartbeat_missed": 3,
            "keepalive_interval": 30000,
            "keepalive_count_max": 12,
            "connection_linger": 300000,
            "orphan_timeout": 172800000,
            "idle": 604800000,
            "unattended": 2592000000
          },
          "buffer_bytes": 8388608,
          "input_frame_max": 1048576
        }
      },
      {
        "from": "worker",
        "msg": {
          "event": "connected",
          "conn_id": "fixture-conn-1"
        }
      },
      {
        "from": "core",
        "msg": {
          "cmd": "open_shell",
          "session_id": "fixture-session-a",
          "term": "xterm-256color",
          "cols": 120,
          "rows": 40
        }
      },
      {
        "from": "worker",
        "msg": {
          "event": "channel_opened",
          "session_id": "fixture-session-a",
          "session_type": "shell",
          "socket": "shell.sock"
        }
      },
      {
        "from": "core",
        "msg": {
          "cmd": "hello",
          "session_id": "fixture-session-a",
          "proto_version": "0.2",
          "last_committed_seq": 0
        },
        "note": "the core dialled the data socket first; nothing is committed yet"
      },
      {
        "from": "worker",
        "msg": {
          "event": "hello_ack",
          "session_id": "fixture-session-a",
          "proto_version": "0.2",
          "first_buffered_seq": 1,
          "first_buffered_offset": 0,
          "current_seq": 0,
          "ended": false
        },
        "note": "nothing buffered and no output yet: first_buffered_seq is current_seq + 1"
      },
      {
        "from": "core",
        "msg": {
          "cmd": "replay",
          "session_id": "fixture-session-a",
          "from_seq": 1
        }
      },
      {
        "from": "worker",
        "msg": {
          "event": "replay_done",
          "session_id": "fixture-session-a",
          "through_seq": 0
        },
        "note": "through_seq 0 < from_seq 1: complete with no frame"
      },
      {
        "from": "core",
        "msg": {
          "cmd": "live",
          "session_id": "fixture-session-a"
        },
        "note": "only now is the session offered northbound (the 201)"
      },
      {
        "from": "worker",
        "msg": {
          "event": "channel_closed",
          "session_id": "fixture-session-a",
          "by": "target",
          "reason": "the shell exited"
        }
      },
      {
        "from": "worker",
        "msg": {
          "event": "input_refused",
          "session_id": "fixture-session-a",
          "seq": 5,
          "reason": "ended"
        },
        "note": "input 5 crossed the end"
      },
      {
        "from": "core",
        "msg": {
          "cmd": "release",
          "session_id": "fixture-session-a"
        }
      }
    ]
  }
}
