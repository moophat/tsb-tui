{
  "seam": "C3",
  "name": "reattach-empty",
  "mark": {
    "required-green": "e1"
  },
  "kind": "sequence",
  "grade": "artifacts:control-reattach",
  "description": "A new session runs the same handshake as a reattach: one path, not three (DEFAULT, approval page). The core dials the session's data socket, then sends hello with last_committed_seq 0; the worker answers current_seq 0 and first_buffered_seq 1 in this capture, though a real target may print its banner first and the ack then reports current_seq ≥ 1 with those bytes in the replay. The replay from 1 writes nothing, and replay_done through 0 (below from_seq) completes it with no frame. The session is offered northbound — the POST /sessions 201, and so any attach — only after live, so a client's first keystrokes are never refused as replaying.",
  "corpus": [
    "immortality §6.1",
    "immortality §4.1",
    "immortality §6.3",
    "immortality §6.4",
    "decision 5.30",
    "plan.md §3 C3"
  ],
  "case": {
    "socket": "conn-control",
    "messages": [
      {
        "from": "core",
        "msg": {
          "cmd": "connect",
          "target_id": "fixture-target",
          "protocol": "ssh",
          "host": "192.0.2.10",
          "port": 22,
          "user": "fixture-user",
          "auth": {
            "kind": "key",
            "key": "FIXTURE-NOT-A-KEY"
          },
          "timers": {
            "heartbeat_interval": 10000,
            "heartbeat_missed": 3,
            "keepalive_interval": 30000,
            "keepalive_count_max": 12,
            "connection_linger": 300000,
            "orphan_timeout": 172800000,
            "idle": 604800000,
            "unattended": 2592000000
          },
          "buffer_bytes": 8388608,
          "input_frame_max": 1048576
        }
      },
      {
        "from": "worker",
        "msg": {
          "event": "connected",
          "conn_id": "fixture-conn-1"
        }
      },
      {
        "from": "core",
        "msg": {
          "cmd": "open_shell",
          "session_id": "fixture-session-a",
          "term": "xterm-256color",
          "cols": 120,
          "rows": 40
        }
      },
      {
        "from": "worker",
        "msg": {
          "event": "channel_opened",
          "session_id": "fixture-session-a",
          "session_type": "shell",
          "socket": "shell.sock"
        }
      },
      {
        "from": "core",
        "msg": {
          "cmd": "hello",
          "session_id": "fixture-session-a",
          "proto_version": "0.2",
          "last_committed_seq": 0
        },
        "note": "the core dialled the data socket first; nothing is committed yet"
      },
      {
        "from": "worker",
        "msg": {
          "event": "hello_ack",
          "session_id": "fixture-session-a",
          "proto_version": "0.2",
          "first_buffered_seq": 1,
          "first_buffered_offset": 0,
          "current_seq": 0,
          "ended": false
        },
        "note": "this capture's worker held no output: first_buffered_seq is current_seq + 1. A real target's banner may already be buffered, and the ack then reports current_seq ≥ 1"
      },
      {
        "from": "core",
        "msg": {
          "cmd": "replay",
          "session_id": "fixture-session-a",
          "from_seq": 1
        }
      },
      {
        "from": "worker",
        "msg": {
          "event": "replay_done",
          "session_id": "fixture-session-a",
          "through_seq": 0
        },
        "note": "through_seq 0 < from_seq 1: complete with no frame"
      },
      {
        "from": "core",
        "msg": {
          "cmd": "live",
          "session_id": "fixture-session-a"
        },
        "note": "only now is the session offered northbound (the 201)"
      }
    ]
  }
}
