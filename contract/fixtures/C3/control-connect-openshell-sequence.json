{
  "seam": "C3",
  "name": "control-connect-openshell-sequence",
  "mark": {
    "required-green": "e0"
  },
  "kind": "sequence",
  "grade": "artifacts:control-sequence",
  "description": "The E0 path on a connection's control socket: connect, with the credential in connect.auth and nowhere else; the worker accepts an unrecorded host key and says so before connected; the core opens a shell, naming the session id it minted; the worker answers channel_opened with the session's type and its data socket. Captured control traffic from a real run must follow the same order.",
  "corpus": [
    "lang-arch §4.1",
    "lang-arch §7.3",
    "Contract §15",
    "decision 5.18",
    "open_decisions §5",
    "immortality §6.1"
  ],
  "case": {
    "socket": "conn-control",
    "messages": [
      {
        "from": "core",
        "msg": {
          "cmd": "connect",
          "target_id": "fixture-target",
          "protocol": "ssh",
          "host": "192.0.2.10",
          "port": 22,
          "user": "fixture-user",
          "auth": {
            "kind": "key",
            "key": "FIXTURE-NOT-A-KEY"
          }
        },
        "note": "credentials travel only here"
      },
      {
        "from": "worker",
        "msg": {
          "event": "hostkey",
          "conn_id": "fixture-conn-1",
          "fingerprint": "SHA256:FIXTURE000000000000000000000000000000000000",
          "first_use": true
        },
        "note": "accept, warn, record"
      },
      {
        "from": "worker",
        "msg": {
          "event": "connected",
          "conn_id": "fixture-conn-1"
        }
      },
      {
        "from": "core",
        "msg": {
          "cmd": "open_shell",
          "session_id": "fixture-session-a",
          "term": "xterm-256color",
          "cols": 120,
          "rows": 40
        }
      },
      {
        "from": "worker",
        "msg": {
          "event": "channel_opened",
          "session_id": "fixture-session-a",
          "session_type": "shell",
          "socket": "shell.sock"
        }
      }
    ]
  }
}
