{
  "seam": "C7",
  "name": "org-credential-store-no-class-invalid",
  "mark": {
    "published": "e4",
    "required-green": "e4"
  },
  "kind": "rest",
  "grade": "reference",
  "graded_by": [
    {
      "unit": "U2",
      "test": "owed: U2's handler tests in core/ (against C7, over a fake vault); E4 phase 6 (U2: auth, locks and the vault and device HTTP handlers over a fake vault); the test is named in phase 16"
    }
  ],
  "description": "An org store without an unlock class is refused, whatever its kind, a no-secret entry included: the class is an explicit choice at storage time and never inferred (credential-protection §8.2, LOCKED; DEFAULT 53). And no field may describe what the account may do on a target: privilege tiering is rejected.",
  "corpus": [
    "credential-protection §8.2",
    "credential-protection §8.3",
    "open_decisions §7",
    "E4 D7",
    "E4 DEFAULT 53"
  ],
  "case": {
    "inputs": [
      "user",
      "password"
    ],
    "steps": [
      {
        "http": {
          "method": "POST",
          "path": "/vault/org-credentials",
          "body": {
            "reference": "fleet-telnet",
            "kind": "none"
          },
          "invalid_body": true
        },
        "expect": {
          "status": 422,
          "example": {
            "error": {
              "code": "invalid_request",
              "message": "an unlock class is required"
            }
          }
        }
      },
      {
        "http": {
          "method": "POST",
          "path": "/vault/org-credentials",
          "body": {
            "reference": "fleet-ro",
            "unlock_class": "broker_unlocked",
            "kind": "password",
            "login_name": "ro",
            "secret": "FIXTURE-NOT-A-PASSWORD",
            "privilege": "read-only"
          },
          "invalid_body": true
        },
        "expect": {
          "status": 422,
          "example": {
            "error": {
              "code": "invalid_request",
              "message": "the body is not an org store request"
            }
          }
        }
      }
    ]
  }
}
