{
  "seam": "C7",
  "name": "credential-store-missing-login-name-invalid",
  "mark": {
    "published": "e4",
    "required-green": "e4"
  },
  "kind": "rest",
  "grade": "reference",
  "graded_by": [
    {
      "unit": "U2",
      "test": "owed: U2's handler tests in core/ (against C7, over a fake vault); E4 phase 6 (U2: auth, locks and the vault and device HTTP handlers over a fake vault); the test is named in phase 16"
    }
  ],
  "description": "A personal store of a key or a password without the login name it logs in as is not the request's shape: 422 invalid_request (DEFAULT 52: the credential's login name reaches the target, never the target file's options.user). So is a secret on a no-secret entry, and a password past 1024 characters.",
  "corpus": [
    "credential-protection §10.3",
    "Storage §7.2",
    "E4 DEFAULT 52",
    "E4 DEFAULT 59"
  ],
  "case": {
    "inputs": [
      "user",
      "password"
    ],
    "steps": [
      {
        "http": {
          "method": "POST",
          "path": "/vault/credentials",
          "body": {
            "reference": "lab-switch",
            "kind": "password",
            "secret": "FIXTURE-NOT-A-PASSWORD"
          },
          "invalid_body": true
        },
        "expect": {
          "status": 422,
          "example": {
            "error": {
              "code": "invalid_request",
              "message": "a login name is required"
            }
          }
        }
      },
      {
        "http": {
          "method": "POST",
          "path": "/vault/credentials",
          "body": {
            "reference": "lab-telnet",
            "kind": "none",
            "secret": "FIXTURE-NOT-A-PASSWORD"
          },
          "invalid_body": true
        },
        "expect": {
          "status": 422,
          "example": {
            "error": {
              "code": "invalid_request",
              "message": "a no-secret entry carries no secret"
            }
          }
        }
      },
      {
        "http": {
          "method": "POST",
          "path": "/vault/credentials",
          "body": {
            "reference": "supplied",
            "kind": "password",
            "login_name": "n",
            "secret": "FIXTURE-NOT-A-PASSWORD"
          },
          "invalid_body": true
        },
        "expect": {
          "status": 422,
          "example": {
            "error": {
              "code": "invalid_request",
              "message": "that reference is reserved"
            }
          }
        }
      }
    ]
  }
}
