{
  "seam": "C7",
  "name": "org-credential-store-broker",
  "mark": {
    "published": "e4",
    "required-green": "e4"
  },
  "kind": "rest",
  "grade": "reference",
  "graded_by": [
    {
      "unit": "U2",
      "test": "owed: U2's handler tests in core/ (against C7, over a fake vault); E4 phase 6 (U2: auth, locks and the vault and device HTTP handlers over a fake vault); the test is named in phase 16"
    },
    {
      "unit": "U6",
      "test": "owed: U6's tests in vault/; E4 phases 7-9 (U6: vault core, device trust, org tier and grants); the test is named in phase 16"
    }
  ],
  "description": "Store an org credential, a vault administrator only (403 forbidden otherwise), with its unlock class chosen explicitly and never inferred; the cred.store line carries the class. On a deployment with no broker key the class is refused, 409 broker_unlock_unavailable: opt-in by construction (DEFAULT 7).",
  "corpus": [
    "credential-protection §8.2",
    "credential-protection §8.3",
    "open_decisions §7",
    "E4 D7",
    "E4 DEFAULT 53"
  ],
  "case": {
    "inputs": [
      "user",
      "password",
      "peer_user",
      "peer_password"
    ],
    "steps": [
      {
        "http": {
          "method": "POST",
          "path": "/vault/org-credentials",
          "body": {
            "reference": "fleet-backup",
            "unlock_class": "broker_unlocked",
            "kind": "password",
            "login_name": "svc-backup",
            "secret": "FIXTURE-NOT-A-PASSWORD",
            "label": "Backup account"
          }
        },
        "expect": {
          "status": 201,
          "example": {
            "reference": "fleet-backup",
            "unlock_class": "broker_unlocked",
            "kind": "password"
          }
        }
      },
      {
        "http": {
          "method": "POST",
          "path": "/vault/org-credentials",
          "as": "peer",
          "body": {
            "reference": "fleet-backup",
            "unlock_class": "broker_unlocked",
            "kind": "password",
            "login_name": "svc-backup",
            "secret": "FIXTURE-NOT-A-PASSWORD",
            "label": "Backup account"
          }
        },
        "expect": {
          "status": 403,
          "example": {
            "error": {
              "code": "forbidden",
              "message": "vault administration only"
            }
          }
        }
      },
      {
        "http": {
          "method": "POST",
          "path": "/vault/org-credentials",
          "body": {
            "reference": "fleet-backup",
            "unlock_class": "broker_unlocked",
            "kind": "password",
            "login_name": "svc-backup",
            "secret": "FIXTURE-NOT-A-PASSWORD",
            "label": "Backup account"
          }
        },
        "expect": {
          "status": 409,
          "example": {
            "error": {
              "code": "broker_unlock_unavailable",
              "message": "this deployment holds no broker key"
            }
          }
        }
      }
    ]
  }
}
