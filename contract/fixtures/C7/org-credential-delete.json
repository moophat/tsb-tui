{
  "seam": "C7",
  "name": "org-credential-delete",
  "mark": {
    "published": "e4",
    "required-green": "e4"
  },
  "kind": "rest",
  "grade": "reference",
  "graded_by": [
    {
      "unit": "U2",
      "test": "owed: U2's handler tests in core/ (against C7, over a fake vault); E4 phase 6 (U2: auth, locks and the vault and device HTTP handlers over a fake vault); the test is named in phase 16"
    },
    {
      "unit": "U6",
      "test": "owed: U6's tests in vault/; E4 phases 7-9 (U6: vault core, device trust, org tier and grants); the test is named in phase 16"
    }
  ],
  "description": "Delete an org credential, a vault administrator only: refused 409 credential_has_grants while a grant names it (DEFAULT 25); an unknown reference is 404 credential_not_found.",
  "corpus": [
    "credential-protection §8.2",
    "credential-protection §8.3",
    "open_decisions §7",
    "E4 D7",
    "E4 DEFAULT 53",
    "E4 DEFAULT 25"
  ],
  "case": {
    "inputs": [
      "user",
      "password"
    ],
    "steps": [
      {
        "http": {
          "method": "DELETE",
          "path": "/vault/org-credentials/fleet-telnet"
        },
        "expect": {
          "status": 204
        }
      },
      {
        "http": {
          "method": "DELETE",
          "path": "/vault/org-credentials/fleet-backup"
        },
        "expect": {
          "status": 409,
          "example": {
            "error": {
              "code": "credential_has_grants",
              "message": "revoke its grants first"
            }
          }
        }
      },
      {
        "http": {
          "method": "DELETE",
          "path": "/vault/org-credentials/no-such-ref"
        },
        "expect": {
          "status": 404,
          "example": {
            "error": {
              "code": "credential_not_found",
              "message": "no such credential"
            }
          }
        }
      }
    ]
  }
}
