  "description": "A registration needs an initialised vault: 409 vault_not_initialized for a principal with none (the peer here).",
  "corpus": [
    "credential-protection Amendment 2026-09-14",
    "credential-protection §5.2",
    "credential-protection §5.3",
    "credential-protection §7.2",
    "device-trust",
    "E4 DEFAULT 39",
    "E4 DEFAULT 69"
  ],
  "case": {
    "inputs": [
      "user",
      "password",
      "peer_user",
      "peer_password"
    ],
    "steps": [
      {
        "http": {
          "method": "POST",
          "path": "/devices/challenges",
          "as": "peer",
          "body": {
            "operation": "device.register",
            "device_id": "FIXTURE-DEVICE-ID-AAAAAAAAAAAAAAAAAAAAAAAAA"
          }
        },
        "expect": {
          "status": 200,
          "example": {
            "challenge_id": "ch-0001",
            "challenge": "RklYVFVSRS1DSEFMTEVOR0UtMDAwMDAwMDAwMDAwMDA=",
            "login_handle": "lh-fixture-0001",
            "expires_in": 30
          }
        }
      },
      {
        "http": {
          "method": "POST",
          "path": "/devices",
          "as": "peer",
          "body": {
            "challenge_id": "ch-0001",
            "part1": "RklYVFVSRS1QQVJUMS0wMA==",
            "part2": "RklYVFVSRS1QQVJUMi0wMA==",
            "public_key": "MFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAEAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==",
            "signature": "RklYVFVSRS1TSUdOQVRVUkUtMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMA==",
            "device_name": "Work laptop"
          }
        },
        "expect": {
          "status": 409,
          "example": {
            "error": {
              "code": "vault_not_initialized",
              "message": "set up the vault first"
            }
          }
        }
      }
    ]
  }
}
