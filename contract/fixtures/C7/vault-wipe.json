{
  "seam": "C7",
  "name": "vault-wipe",
  "mark": {
    "published": "e4",
    "required-green": "e4"
  },
  "kind": "rest",
  "grade": "reference",
  "graded_by": [
    {
      "unit": "U2",
      "test": "owed: U2's handler tests in core/ (against C7, over a fake vault); E4 phase 6 (U2: auth, locks and the vault and device HTTP handlers over a fake vault); the test is named in phase 16"
    },
    {
      "unit": "U6",
      "test": "owed: U6's tests in vault/; E4 phases 7-9 (U6: vault core, device trust, org tier and grants); the test is named in phase 16"
    }
  ],
  "description": "A vault administrator wipes a user's vault (D16): 204. Without vault.admin, 403 forbidden; an unknown user, 404 user_not_found; a user who stored user-unlocked org credentials, 409 vault_wipe_blocked naming them (O31). The run's login is the administrator here and the peer is not.",
  "corpus": [
    "E4 D16",
    "E4 DEFAULT 46",
    "credential-protection §7.4",
    "E4 O31 (ruled 2026-10-29 14:40)"
  ],
  "case": {
    "inputs": [
      "user",
      "password",
      "peer_user",
      "peer_password"
    ],
    "steps": [
      {
        "http": {
          "method": "DELETE",
          "path": "/vault/users/fixture-peer"
        },
        "expect": {
          "status": 204
        }
      },
      {
        "http": {
          "method": "DELETE",
          "path": "/vault/users/fixture-user",
          "as": "peer"
        },
        "expect": {
          "status": 403,
          "example": {
            "error": {
              "code": "forbidden",
              "message": "vault administration only"
            }
          }
        }
      },
      {
        "http": {
          "method": "DELETE",
          "path": "/vault/users/nobody"
        },
        "expect": {
          "status": 404,
          "example": {
            "error": {
              "code": "user_not_found",
              "message": "no such user"
            }
          }
        }
      },
      {
        "http": {
          "method": "DELETE",
          "path": "/vault/users/fixture-admin2"
        },
        "expect": {
          "status": 409,
          "example": {
            "error": {
              "code": "vault_wipe_blocked",
              "message": "the user stored user-unlocked org credentials",
              "credential_refs": [
                "fleet-backup"
              ]
            }
          }
        }
      }
    ]
  }
}
