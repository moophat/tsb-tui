{
  "seam": "C7",
  "name": "part2-regenerate",
  "mark": {
    "published": "e4",
    "required-green": "e4"
  },
  "kind": "rest",
  "grade": "reference",
  "graded_by": [
    {
      "unit": "U2",
      "test": "owed: U2's handler tests in core/ (against C7, over a fake vault); E4 phase 6 (U2: auth, locks and the vault and device HTTP handlers over a fake vault); the test is named in phase 16"
    },
    {
      "unit": "U6",
      "test": "owed: U6's tests in vault/; E4 phases 7-9 (U6: vault core, device trust, org tier and grants); the test is named in phase 16"
    }
  ],
  "description": "Part 2 regeneration (credential-protection §9, §7.2 step 3): after part2_missing the surface derives both halves afresh with the passphrase it holds, asks a part2.regenerate challenge for this login's tied device and sends both halves with the signature. The core stores Part 2 with a fresh TTL only for an allowlisted device and only when part1 ‖ part2 opens the set (D4), and the login then holds an unlock. A body without the signature is 422.",
  "corpus": [
    "credential-protection §4.1",
    "credential-protection §5.1",
    "credential-protection §5.4",
    "vault-unlock",
    "credential-protection Amendment 2026-09-14",
    "credential-protection §5.2",
    "credential-protection §5.3",
    "credential-protection §7.2",
    "device-trust",
    "E4 D4",
    "E4 DEFAULT 43"
  ],
  "case": {
    "inputs": [
      "user",
      "password"
    ],
    "steps": [
      {
        "http": {
          "method": "POST",
          "path": "/devices/challenges",
          "body": {
            "operation": "part2.regenerate",
            "device_id": "FIXTURE-DEVICE-ID-AAAAAAAAAAAAAAAAAAAAAAAAA"
          }
        },
        "expect": {
          "status": 200,
          "example": {
            "challenge_id": "ch-0001",
            "challenge": "RklYVFVSRS1DSEFMTEVOR0UtMDAwMDAwMDAwMDAwMDA=",
            "login_handle": "lh-fixture-0001",
            "expires_in": 30
          }
        }
      },
      {
        "http": {
          "method": "POST",
          "path": "/vault/part2",
          "body": {
            "challenge_id": "ch-0001",
            "part1": "RklYVFVSRS1QQVJUMS0wMA==",
            "part2": "RklYVFVSRS1QQVJUMi0wMA==",
            "signature": "RklYVFVSRS1TSUdOQVRVUkUtMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMA=="
          }
        },
        "expect": {
          "status": 204
        }
      },
      {
        "http": {
          "method": "POST",
          "path": "/vault/part2",
          "body": {
            "challenge_id": "ch-0001",
            "part1": "RklYVFVSRS1QQVJUMS0wMA==",
            "part2": "RklYVFVSRS1QQVJUMi0wMA=="
          },
          "invalid_body": true
        },
        "expect": {
          "status": 422,
          "example": {
            "error": {
              "code": "invalid_request",
              "message": "the body is not a regeneration request"
            }
          }
        }
      }
    ]
  }
}
