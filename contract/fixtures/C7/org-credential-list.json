{
  "seam": "C7",
  "name": "org-credential-list",
  "mark": {
    "published": "e4",
    "required-green": "e4"
  },
  "kind": "rest",
  "grade": "reference",
  "graded_by": [
    {
      "unit": "U2",
      "test": "owed: U2's handler tests in core/ (against C7, over a fake vault); E4 phase 6 (U2: auth, locks and the vault and device HTTP handlers over a fake vault); the test is named in phase 16"
    }
  ],
  "description": "List the org credentials, a vault administrator only: reference, class, kind and the storing administrator; the label only where the core can open the blob now.",
  "corpus": [
    "credential-protection §8.2",
    "credential-protection §8.3",
    "open_decisions §7",
    "E4 D7",
    "E4 DEFAULT 53"
  ],
  "case": {
    "inputs": [
      "user",
      "password",
      "peer_user",
      "peer_password"
    ],
    "steps": [
      {
        "http": {
          "method": "GET",
          "path": "/vault/org-credentials"
        },
        "expect": {
          "status": 200,
          "example": {
            "credentials": [
              {
                "reference": "fleet-backup",
                "unlock_class": "broker_unlocked",
                "kind": "password",
                "label": "Backup account",
                "stored_by": "fixture-user"
              },
              {
                "reference": "fleet-tacacs",
                "unlock_class": "user_unlocked",
                "kind": "key",
                "stored_by": "fixture-user"
              }
            ]
          }
        }
      },
      {
        "http": {
          "method": "GET",
          "path": "/vault/org-credentials",
          "as": "peer"
        },
        "expect": {
          "status": 403,
          "example": {
            "error": {
              "code": "forbidden",
              "message": "vault administration only"
            }
          }
        }
      }
    ]
  }
}
