{
  "seam": "C7",
  "name": "salt-mint-repeat-same-salts",
  "mark": {
    "published": "e4",
    "required-green": "e4"
  },
  "kind": "rest",
  "grade": "reference",
  "graded_by": [
    {
      "unit": "U2",
      "test": "owed: U2's handler tests in core/ (against C7, over a fake vault); E4 phase 6 (U2: auth, locks and the vault and device HTTP handlers over a fake vault); the test is named in phase 16"
    },
    {
      "unit": "U6",
      "test": "owed: U6's tests in vault/; E4 phases 7-9 (U6: vault core, device trust, org tier and grants); the test is named in phase 16"
    },
    {
      "unit": "U11",
      "test": "owed: a U11 rig against the lab core; E4 phase 11 (U11: the E4 rigs against the lab core); the rig is named in phase 16"
    }
  ],
  "description": "A repeated mint on a vault that is minted but not sealed answers the same salts and writes nothing: a surface that lost the first answer mints again and derives from the same user_salt, and the salt read answers it too, initialized false until init seals (ruling 2026-10-29 21:07).",
  "corpus": [
    "credential-protection §4.1",
    "credential-protection §4.2",
    "E4 DEFAULT 2",
    "E4 DEFAULT 35",
    "E4 DEFAULT 46",
    "E4 phase 1 OPEN-1.3 (c)",
    "orchestrator ruling 2026-10-29 21:07 (G1)",
    "vault-unlock"
  ],
  "case": {
    "inputs": [
      "user",
      "password",
      "peer_user",
      "peer_password"
    ],
    "steps": [
      {
        "http": {
          "method": "POST",
          "path": "/vault/salt",
          "as": "peer"
        },
        "expect": {
          "status": 200,
          "example": {
            "initialized": false,
            "user_salt": "RklYVFVSRS1TQUxULTAwMA=="
          }
        },
        "save": {
          "minted": "/user_salt"
        }
      },
      {
        "http": {
          "method": "POST",
          "path": "/vault/salt",
          "as": "peer"
        },
        "expect": {
          "status": 200,
          "match": [
            {
              "pointer": "/user_salt",
              "eq": "${minted}"
            }
          ],
          "example": {
            "initialized": false,
            "user_salt": "RklYVFVSRS1TQUxULTAwMA=="
          }
        }
      },
      {
        "http": {
          "method": "GET",
          "path": "/vault/salt",
          "as": "peer"
        },
        "expect": {
          "status": 200,
          "match": [
            {
              "pointer": "/user_salt",
              "eq": "${minted}"
            },
            {
              "pointer": "/initialized",
              "eq": false
            }
          ],
          "example": {
            "initialized": false,
            "user_salt": "RklYVFVSRS1TQUxULTAwMA=="
          }
        }
      }
    ]
  }
}
