{
  "seam": "C7",
  "name": "device-list",
  "mark": {
    "published": "e4",
    "required-green": "e4"
  },
  "kind": "rest",
  "grade": "reference",
  "graded_by": [
    {
      "unit": "U2",
      "test": "owed: U2's handler tests in core/ (against C7, over a fake vault); E4 phase 6 (U2: auth, locks and the vault and device HTTP handlers over a fake vault); the test is named in phase 16"
    }
  ],
  "description": "List devices: the caller's own, revoked ones included and marked, never a key; ?user= naming another principal is a vault administrator's question, 403 forbidden to anyone else (the peer here holds no vault.admin).",
  "corpus": [
    "credential-protection Amendment 2026-09-14",
    "credential-protection §5.2",
    "credential-protection §5.3",
    "credential-protection §7.2",
    "device-trust",
    "credential-protection §7.1",
    "E4 Q6 (a)"
  ],
  "case": {
    "inputs": [
      "user",
      "password",
      "peer_user",
      "peer_password"
    ],
    "steps": [
      {
        "http": {
          "method": "GET",
          "path": "/devices"
        },
        "expect": {
          "status": 200,
          "example": {
            "devices": [
              {
                "device_id": "FIXTURE-DEVICE-ID-AAAAAAAAAAAAAAAAAAAAAAAAA",
                "device_name": "Work laptop",
                "registered_at": "2026-10-29T08:00:00Z",
                "last_used_at": "2026-10-29T08:00:00Z"
              },
              {
                "device_id": "FIXTURE-DEVICE-ID-BBBBBBBBBBBBBBBBBBBBBBBBA",
                "device_name": "Old desktop",
                "registered_at": "2026-10-29T08:00:00Z",
                "last_used_at": "2026-10-29T08:00:00Z",
                "revoked_at": "2026-10-29T08:00:00Z",
                "revoke_reason": "inactive"
              }
            ]
          }
        }
      },
      {
        "http": {
          "method": "GET",
          "path": "/devices?user=fixture-user",
          "as": "peer"
        },
        "expect": {
          "status": 403,
          "example": {
            "error": {
              "code": "forbidden",
              "message": "vault administration only"
            }
          }
        }
      }
    ]
  }
}
