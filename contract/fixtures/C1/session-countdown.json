{
  "seam": "C1",
  "name": "session-countdown",
  "mark": {
    "required-green": "e1"
  },
  "kind": "rest",
  "grade": "live",
  "description": "Every session record not yet ended carries the countdown (session model §11 expiry_notice): ends_at, when the soonest timer that will end it fires if nothing resets it; ends_by, which timer that is; ending, whether it is inside a warning window. The core computes them, so a user who logs in sees each session and when it will be killed; a surface only renders them. The fixture asserts that they are there, never what they are, so it holds whatever the timer values are.",
  "corpus": [
    "session model §11",
    "session model §15",
    "development-plan.md §2 v0.2"
  ],
  "case": {
    "inputs": [
      "user",
      "password",
      "target_id"
    ],
    "steps": [
      {
        "http": {
          "method": "POST",
          "path": "/sessions",
          "body": {
            "target_id": "${target_id}",
            "connection": "new",
            "term": "xterm-256color",
            "cols": 120,
            "rows": 40
          }
        },
        "expect": {
          "status": 201,
          "match": [
            {
              "pointer": "/session/ends_at",
              "present": true
            },
            {
              "pointer": "/session/ends_by",
              "present": true
            },
            {
              "pointer": "/session/ending",
              "present": true
            }
          ]
        },
        "save": {
          "sid": "/session/id"
        }
      },
      {
        "http": {
          "method": "GET",
          "path": "/sessions/${sid}"
        },
        "expect": {
          "status": 200,
          "match": [
            {
              "pointer": "/ends_at",
              "present": true
            },
            {
              "pointer": "/ends_by",
              "present": true
            }
          ],
          "example": {
            "id": "fixture-session-a",
            "target_id": "fixture-target",
            "connection_id": "fixture-conn-1",
            "session_type": "shell",
            "state": "detached",
            "tier": 1,
            "owner": "fixture-user",
            "control_holder": null,
            "created_at": "2026-09-23T12:00:00Z",
            "term": "xterm-256color",
            "cols": 120,
            "rows": 40,
            "recording": {
              "active": true,
              "warning_code": "recording.active",
              "warning_text": "This session is recorded byte-perfect. Anything typed will be stored as-is."
            },
            "ends_at": "2026-09-30T12:00:00Z",
            "ends_by": "idle",
            "ending": false
          }
        }
      }
    ],
    "cleanup": [
      {
        "method": "DELETE",
        "path": "/sessions/${sid}"
      }
    ]
  }
}
