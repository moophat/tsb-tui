{
  "seam": "C1",
  "name": "target-import-no-secret",
  "mark": {
    "published": "e3b",
    "required-green": "e3b"
  },
  "kind": "rest",
  "grade": "live",
  "description": "A credential-free YAML import needs no credential choice or vault unlock and stores no credential; provider cases also cover unreadable and key-path-only exports.",
  "corpus": [
    "Storage \u00a77.4",
    "Contract \u00a712"
  ],
  "case": {
    "inputs": [
      "user",
      "password"
    ],
    "steps": [
      {
        "http": {
          "method": "POST",
          "path": "/target-imports",
          "body": {
            "action": "preview",
            "format": "yaml",
            "export_bytes": ""
          }
        },
        "expect": {
          "status": 200,
          "example": {
            "import_id": "imp-aaaaaaaaaaaaaaaaaaaaaaaaaa",
            "preview_token": "fixture_token",
            "format": "yaml",
            "targets": [
              {
                "entry": {
                  "index": 1,
                  "name": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
                },
                "source_ref": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
                "target": {
                  "id": "g-aaaaaaaaaaaaaaaaaaaaaaaaaa",
                  "type": "ssh",
                  "name": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
                  "tags": [
                    "lab"
                  ],
                  "discovered_by": "tsb",
                  "host": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
                  "port": 22,
                  "vendor": "cisco",
                  "prompt_pattern": ""
                },
                "change": "create",
                "n": 0,
                "has_credentials": false,
                "key_file_referenced": false,
                "definition": {
                  "id": "g-aaaaaaaaaaaaaaaaaaaaaaaaaa",
                  "type": "ssh",
                  "name": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
                  "discovered_by": "tsb",
                  "options": {
                    "host": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
                  },
                  "tags": [
                    "lab"
                  ],
                  "vendor": "cisco",
                  "prompt_pattern": ""
                },
                "mapping": null
              }
            ],
            "not_carried": [],
            "credentials": []
          },
          "match": [
            {
              "pointer": "/format",
              "eq": "yaml"
            },
            {
              "pointer": "/targets/0/source_ref",
              "eq": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
            },
            {
              "pointer": "/targets/0/change",
              "eq": "create"
            },
            {
              "pointer": "/targets/0/definition/tags/0",
              "eq": "lab"
            },
            {
              "pointer": "/targets/0/definition/vendor",
              "eq": "cisco"
            },
            {
              "pointer": "/targets/0/definition/prompt_pattern",
              "eq": ""
            },
            {
              "pointer": "",
              "not_contains": [
                "FIXTURE-NOT-A-PASSWORD"
              ]
            },
            {
              "pointer": "/targets/0/target/id",
              "ne": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
            }
          ],
          "headers": {
            "Cache-Control": "no-store"
          }
        },
        "save": {
          "import_token": "/preview_token",
          "target_id": "/targets/0/target/id"
        }
      },
      {
        "http": {
          "method": "POST",
          "path": "/target-imports",
          "body": {
            "action": "commit",
            "format": "yaml",
            "export_bytes": "",
            "preview_token": "${import_token}"
          }
        },
        "expect": {
          "status": 200,
          "match": [
            {
              "pointer": "/outcome",
              "eq": "written"
            },
            {
              "pointer": "/credentials/choice",
              "eq": "none"
            },
            {
              "pointer": "/credentials/stored",
              "eq": []
            },
            {
              "pointer": "",
              "not_contains": [
                "FIXTURE-NOT-A-PASSWORD"
              ]
            }
          ],
          "example": {
            "outcome": "written",
            "import_id": "imp-aaaaaaaaaaaaaaaaaaaaaaaaaa",
            "targets": [
              {
                "id": "g-aaaaaaaaaaaaaaaaaaaaaaaaaa",
                "type": "ssh",
                "name": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
                "tags": [
                  "lab"
                ],
                "discovered_by": "tsb",
                "host": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
                "port": 22,
                "vendor": "cisco",
                "prompt_pattern": ""
              }
            ],
            "not_carried": [],
            "credentials": {
              "choice": "none",
              "stored": [],
              "mappings": []
            }
          },
          "headers": {
            "Cache-Control": "no-store"
          }
        }
      },
      {
        "http": {
          "method": "GET",
          "path": "/targets/${target_id}"
        },
        "expect": {
          "status": 200,
          "example": {
            "id": "g-aaaaaaaaaaaaaaaaaaaaaaaaaa",
            "type": "ssh",
            "name": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
            "tags": [
              "lab"
            ],
            "discovered_by": "tsb",
            "host": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
            "port": 22,
            "vendor": "cisco",
            "prompt_pattern": ""
          },
          "match": [
            {
              "pointer": "/id",
              "eq": "${target_id}"
            },
            {
              "pointer": "",
              "not_contains": [
                "FIXTURE-NOT-A-PASSWORD"
              ]
            }
          ]
        }
      }
    ],
    "cleanup": [
      {
        "method": "DELETE",
        "path": "/targets/${target_id}"
      }
    ]
  }
}
