{
  "seam": "C1",
  "name": "auth-login-bad-password",
  "mark": {
    "required-green": "e0"
  },
  "kind": "rest",
  "grade": "live",
  "description": "A wrong password is refused with 401 invalid_credentials — the code an unknown user also gets, so the answer does not reveal which accounts exist — and no session cookie is set. The core audits it as auth.login_failed (C6).",
  "corpus": [
    "decision 5.34",
    "Storage §6"
  ],
  "case": {
    "inputs": [
      "user"
    ],
    "steps": [
      {
        "http": {
          "method": "POST",
          "path": "/auth/login",
          "as": "none",
          "body": {
            "username": "${user}",
            "password": "FIXTURE-WRONG-PASSWORD"
          }
        },
        "expect": {
          "status": 401,
          "cookie": {
            "set": false
          },
          "match": [
            {
              "pointer": "/error/code",
              "eq": "invalid_credentials"
            }
          ],
          "example": {
            "error": {
              "code": "invalid_credentials",
              "message": "unknown user or wrong password"
            }
          }
        }
      }
    ]
  }
}
