{
  "seam": "C1",
  "name": "target-login-hint-caller-scope",
  "mark": {
    "published": "e4",
    "required-green": "e5"
  },
  "kind": "rest",
  "grade": "reference",
  "graded_by": [
    {
      "unit": "U2",
      "test": "owed: Wire list/single-read behavior and runtime/protocol/target-scoped authorization context."
    },
    {
      "unit": "U6",
      "test": "owed: Read only caller personal mappings/index and relevant caller grants; evaluate target matching without unrelated private state."
    }
  ],
  "description": "Only this caller: unmapped saved credentials, another principal mappings and unmatched grants do not count. hint-caller-empty remains none; hint-caller-own has one mapped candidate despite those unrelated entries. Each named target has an exclusive tag equal to its id; filtered list reads select that row for the field-omission checks.",
  "corpus": [
    "Storage §10.1a",
    "Contract §4",
    "Contract §12",
    "inventory-list caller-relative login hint",
    "session-open step 3"
  ],
  "case": {
    "inputs": [
      "user",
      "password"
    ],
    "steps": [
      {
        "http": {
          "method": "GET",
          "path": "/targets?tag=hint-caller-empty"
        },
        "expect": {
          "status": 200,
          "match": [
            {
              "pointer": "/targets",
              "some": {
                "/id": "hint-caller-empty",
                "/login_hint": "none"
              }
            }
          ],
          "example": {
            "targets": [
              {
                "id": "hint-caller-empty",
                "type": "ssh",
                "name": "fixture target",
                "group": "lab",
                "tags": [
                  "hint-caller-empty"
                ],
                "discovered_by": "manual",
                "last_seen": "2026-10-17T08:30:00Z",
                "host": "192.0.2.10",
                "port": 22,
                "login_hint": "none"
              }
            ]
          },
          "headers": {
            "Cache-Control": "no-store"
          }
        }
      },
      {
        "http": {
          "method": "GET",
          "path": "/targets/hint-caller-empty"
        },
        "expect": {
          "status": 200,
          "match": [
            {
              "pointer": "/id",
              "eq": "hint-caller-empty"
            },
            {
              "pointer": "/login_hint",
              "eq": "none"
            }
          ],
          "example": {
            "id": "hint-caller-empty",
            "type": "ssh",
            "name": "fixture target",
            "group": "lab",
            "tags": [
              "hint-caller-empty"
            ],
            "discovered_by": "manual",
            "last_seen": "2026-10-17T08:30:00Z",
            "host": "192.0.2.10",
            "port": 22,
            "login_hint": "none"
          },
          "headers": {
            "Cache-Control": "no-store"
          }
        }
      },
      {
        "http": {
          "method": "GET",
          "path": "/targets?tag=hint-caller-own"
        },
        "expect": {
          "status": 200,
          "match": [
            {
              "pointer": "/targets",
              "some": {
                "/id": "hint-caller-own",
                "/login_hint": "saved"
              }
            }
          ],
          "example": {
            "targets": [
              {
                "id": "hint-caller-own",
                "type": "ssh",
                "name": "fixture target",
                "group": "lab",
                "tags": [
                  "hint-caller-own"
                ],
                "discovered_by": "manual",
                "last_seen": "2026-10-17T08:30:00Z",
                "host": "192.0.2.10",
                "port": 22,
                "login_hint": "saved"
              }
            ]
          },
          "headers": {
            "Cache-Control": "no-store"
          }
        }
      },
      {
        "http": {
          "method": "GET",
          "path": "/targets/hint-caller-own"
        },
        "expect": {
          "status": 200,
          "match": [
            {
              "pointer": "/id",
              "eq": "hint-caller-own"
            },
            {
              "pointer": "/login_hint",
              "eq": "saved"
            }
          ],
          "example": {
            "id": "hint-caller-own",
            "type": "ssh",
            "name": "fixture target",
            "group": "lab",
            "tags": [
              "hint-caller-own"
            ],
            "discovered_by": "manual",
            "last_seen": "2026-10-17T08:30:00Z",
            "host": "192.0.2.10",
            "port": 22,
            "login_hint": "saved"
          },
          "headers": {
            "Cache-Control": "no-store"
          }
        }
      }
    ]
  }
