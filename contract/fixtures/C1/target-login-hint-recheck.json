{
  "seam": "C1",
  "name": "target-login-hint-recheck",
  "mark": {
    "published": "e4",
    "required-green": "e5"
  },
  "kind": "rest",
  "grade": "reference",
  "graded_by": [
    {
      "unit": "U2",
      "test": "owed: Fresh create inputs after concurrent mapping/grant changes; hints never authorize use."
    },
    {
      "unit": "U6",
      "test": "owed: Best-effort per-request metadata snapshots; fresh preparation on later requests, no cross-request cache."
    }
  ],
  "description": "Provider reads a saved hint, revokes its org grant or removes its personal mapping before create, then proves create rechecks and refuses no_resolving_credential; no stale hint authorizes use. Repeat for both changes. No cross-request resolution cache or reservation. Each named target has an exclusive tag equal to its id; filtered list reads select that row for the field-omission checks.",
  "corpus": [
    "Storage §10.1a",
    "Contract §4",
    "Contract §12",
    "inventory-list caller-relative login hint",
    "session-open step 3"
  ],
  "case": {
    "inputs": [
      "user",
      "password"
    ],
    "steps": [
      {
        "http": {
          "method": "GET",
          "path": "/targets?tag=hint-revoked"
        },
        "expect": {
          "status": 200,
          "match": [
            {
              "pointer": "/targets",
              "some": {
                "/id": "hint-revoked",
                "/login_hint": "saved"
              }
            }
          ],
          "example": {
            "targets": [
              {
                "id": "hint-revoked",
                "type": "ssh",
                "name": "fixture target",
                "group": "lab",
                "tags": [
                  "hint-revoked"
                ],
                "discovered_by": "manual",
                "last_seen": "2026-10-17T08:30:00Z",
                "host": "192.0.2.10",
                "port": 22,
                "login_hint": "saved"
              }
            ]
          },
          "headers": {
            "Cache-Control": "no-store"
          }
        }
      },
      {
        "http": {
          "method": "GET",
          "path": "/targets/hint-revoked"
        },
        "expect": {
          "status": 200,
          "match": [
            {
              "pointer": "/id",
              "eq": "hint-revoked"
            },
            {
              "pointer": "/login_hint",
              "eq": "saved"
            }
          ],
          "example": {
            "id": "hint-revoked",
            "type": "ssh",
            "name": "fixture target",
            "group": "lab",
            "tags": [
              "hint-revoked"
            ],
            "discovered_by": "manual",
            "last_seen": "2026-10-17T08:30:00Z",
            "host": "192.0.2.10",
            "port": 22,
            "login_hint": "saved"
          },
          "headers": {
            "Cache-Control": "no-store"
          }
        }
      },
      {
        "http": {
          "method": "POST",
          "path": "/sessions",
          "body": {
            "target_id": "hint-revoked",
            "connection": "new",
            "term": "xterm-256color",
            "cols": 120,
            "rows": 40
          }
        },
        "expect": {
          "status": 409,
          "match": [
            {
              "pointer": "/error/code",
              "eq": "no_resolving_credential"
            }
          ],
          "example": {
            "error": {
              "code": "no_resolving_credential",
              "message": "no credential resolves for this target"
            }
          }
        }
      },
      {
        "http": {
          "method": "GET",
          "path": "/targets?tag=hint-revoked"
        },
        "expect": {
          "status": 200,
          "match": [
            {
              "pointer": "/targets",
              "some": {
                "/id": "hint-revoked",
                "/login_hint": "none"
              }
            }
          ],
          "example": {
            "targets": [
              {
                "id": "hint-revoked",
                "type": "ssh",
                "name": "fixture target",
                "group": "lab",
                "tags": [
                  "hint-revoked"
                ],
                "discovered_by": "manual",
                "last_seen": "2026-10-17T08:30:00Z",
                "host": "192.0.2.10",
                "port": 22,
                "login_hint": "none"
              }
            ]
          },
          "headers": {
            "Cache-Control": "no-store"
          }
        }
      },
      {
        "http": {
          "method": "GET",
          "path": "/targets/hint-revoked"
        },
        "expect": {
          "status": 200,
          "match": [
            {
              "pointer": "/id",
              "eq": "hint-revoked"
            },
            {
              "pointer": "/login_hint",
              "eq": "none"
            }
          ],
          "example": {
            "id": "hint-revoked",
            "type": "ssh",
            "name": "fixture target",
            "group": "lab",
            "tags": [
              "hint-revoked"
            ],
            "discovered_by": "manual",
            "last_seen": "2026-10-17T08:30:00Z",
            "host": "192.0.2.10",
            "port": 22,
            "login_hint": "none"
          },
          "headers": {
