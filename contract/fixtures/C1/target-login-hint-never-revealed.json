  "description": "Provider seeds distinctive canary reference hint-private-ref, label hint-private-label, username hint-private-user, synthetic secret FIXTURE-NOT-A-PASSWORD and host path /fixture-private/credential. None may occur anywhere in list/single response or fixed error text. Repeat after changing a different principal private credentials: this caller output is identical. Only id/type/public inventory fields and the fixed enum are returned; never candidate identities, kind, storing administrator or unlock state. Each named target has an exclusive tag equal to its id; filtered list reads select that row for the field-omission checks.",
  "corpus": [
    "Storage §10.1a",
    "Contract §4",
    "Contract §12",
    "inventory-list caller-relative login hint",
    "session-open step 3"
  ],
  "case": {
    "inputs": [
      "user",
      "password"
    ],
    "steps": [
      {
        "http": {
          "method": "GET",
          "path": "/targets?tag=hint-private"
        },
        "expect": {
          "status": 200,
          "match": [
            {
              "pointer": "/targets",
              "some": {
                "/id": "hint-private",
                "/login_hint": "saved"
              }
            },
            {
              "pointer": "",
              "not_contains": [
                "hint-private-ref",
                "hint-private-label",
                "hint-private-user",
                "FIXTURE-NOT-A-PASSWORD",
                "/fixture-private/credential"
              ]
            }
          ],
          "example": {
            "targets": [
              {
                "id": "hint-private",
                "type": "ssh",
                "name": "fixture target",
                "group": "lab",
                "tags": [
                  "hint-private"
                ],
                "discovered_by": "manual",
                "last_seen": "2026-10-17T08:30:00Z",
                "host": "192.0.2.10",
                "port": 22,
                "login_hint": "saved"
              }
            ]
          },
          "headers": {
            "Cache-Control": "no-store"
          }
        }
      },
