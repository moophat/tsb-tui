  "mark": {
    "published": "e3",
    "required-green": "e4"
  },
  "kind": "rest",
  "grade": "live",
  "description": "Each forbidden field and a telnet user are refused by the closed definition, before permission; no target is written.",
  "corpus": [
    "Storage §3.5",
    "Storage §9",
    "Storage §10.1",
    "Contract §4"
  ],
  "case": {
    "inputs": [
      "user",
      "password"
    ],
    "steps": [
      {
        "http": {
          "method": "POST",
          "path": "/targets",
          "body": {
            "id": "fixture-w-${nonce}",
            "type": "ssh",
            "host": "192.0.2.60",
            "password": "FIXTURE-NOT-A-PASSWORD"
          },
          "invalid_body": true
        },
        "expect": {
          "status": 422,
          "match": [
            {
              "pointer": "/error/code",
              "eq": "invalid_request"
            }
          ],
          "example": {
            "error": {
              "code": "invalid_request",
              "message": "target request refused"
            }
          }
        }
      },
