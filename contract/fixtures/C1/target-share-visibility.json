{
  "seam": "C1",
  "name": "target-share-visibility",
  "mark": {
    "published": "e3b",
    "required-green": "e3b"
  },
  "kind": "rest",
  "grade": "reference",
  "graded_by": [
    {
      "unit": "U2",
      "test": "owed: TestTheNamedSeeAnOwnTargetWithoutDiscoverOrFilters"
    },
    {
      "unit": "U2",
      "test": "owed: TestOwnerDisableHidesFromEveryoneNamed"
    },
    {
      "unit": "U2",
      "test": "owed: TestRemovingANameEndsNoSession"
    },
    {
      "unit": "U2",
      "test": "owed: TestMembershipIsCheckedAgainstTheParsedInventory"
    }
  ],
  "description": "User creates own target with peer in share list; peer sees it in get and list with share and owner; user removes peer from list; peer gets absent-equivalent 404.",
  "corpus": [
    "Storage §3.5",
    "Storage §10.1b",
    "Contract §4"
  ],
  "case": {
    "inputs": [
      "user",
      "password",
      "peer_user",
      "peer_password"
    ],
    "steps": [
      {
        "http": {
          "method": "POST",
          "path": "/targets",
          "body": {
            "type": "ssh",
            "host": "fixture.invalid",
            "share": [
              "fixture-user",
              "peer"
            ]
          }
        },
        "expect": {
          "status": 201
        },
        "save": {
          "target_id": "/id"
        }
      },
      {
        "http": {
          "method": "GET",
          "path": "/targets/${target_id}",
          "as": "peer"
        },
        "expect": {
          "status": 200,
          "match": [
            {
              "pointer": "/id",
              "eq": "${target_id}"
            },
            {
              "pointer": "/share",
              "eq": [
                "fixture-user",
                "peer"
              ]
            },
            {
              "pointer": "/owner",
              "eq": "fixture-user"
            }
          ]
        }
      },
      {
        "http": {
          "method": "GET",
          "path": "/targets",
          "as": "peer"
        },
        "expect": {
          "status": 200,
          "match": [
            {
              "pointer": "/targets",
              "some": {
                "/id": "${target_id}"
              }
            }
          ]
        }
      },
      {
        "http": {
          "method": "PUT",
          "path": "/targets/${target_id}",
          "body": {
            "id": "${target_id}",
            "type": "ssh",
            "host": "fixture.invalid",
            "share": [
              "fixture-user"
            ]
          }
        },
        "expect": {
          "status": 200
        }
      },
      {
        "http": {
          "method": "GET",
          "path": "/targets/${target_id}",
          "as": "peer"
        },
        "expect": {
          "status": 404,
          "match": [
            {
              "pointer": "/error/code",
              "eq": "target_not_found"
            }
          ],
          "example": {
            "error": {
              "code": "target_not_found",
              "message": "no target with this id"
            }
          }
        }
      }
    ],
    "cleanup": [
      {
        "method": "DELETE",
        "path": "/targets/${target_id}"
      }
    ]
  }
}
