{
  "seam": "C1",
  "name": "target-import-invalid-option-rows",
  "mark": {
    "published": "e3b",
    "required-green": "e3b"
  },
  "kind": "rest",
  "grade": "live",
  "description": "A YAML entry with an out-of-range timer or size is skipped and reported as an invalid row; the valid row keeps its preview and its carried options obey the inventory schema bounds.",
  "corpus": [
    "Storage \u00a77.4",
    "Contract \u00a712"
  ],
  "case": {
    "inputs": [
      "user",
      "password"
    ],
    "steps": [
      {
        "http": {
          "method": "POST",
          "path": "/target-imports",
          "body": {
            "action": "preview",
            "format": "yaml",
            "export_bytes": ""
          }
        },
        "expect": {
          "status": 200,
          "example": {
            "import_id": "imp-aaaaaaaaaaaaaaaaaaaaaaaaaa",
            "preview_token": "fixture_token",
            "format": "yaml",
            "targets": [
              {
                "entry": {
                  "index": 4,
                  "name": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaax"
                },
                "source_ref": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaax",
                "target": {
                  "id": "g-aaaaaaaaaaaaaaaaaaaaaaaaaa",
                  "type": "ssh",
                  "name": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaax",
                  "tags": [],
                  "discovered_by": "tsb",
                  "host": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaz",
                  "port": 22
                },
                "change": "create",
                "n": 0,
                "has_credentials": false,
                "key_file_referenced": false,
                "definition": {
                  "id": "g-aaaaaaaaaaaaaaaaaaaaaaaaaa",
                  "type": "ssh",
                  "name": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaax",
                  "discovered_by": "tsb",
                  "options": {
                    "host": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaz",
                    "connection_linger": 30,
                    "login_timeout": 10,
                    "size_floor": {
                      "cols": 80,
                      "rows": 24
                    }
                  },
                  "import_ref": {
                    "format": "yaml",
                    "source_ref": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaax"
                  }
                },
                "mapping": null
              }
            ],
            "not_carried": [
              {
                "locator": {
                  "index": 1
                },
                "kind": "row",
                "reason": "invalid_entry"
              },
              {
                "locator": {
                  "index": 2
                },
                "kind": "row",
                "reason": "invalid_entry"
              },
              {
                "locator": {
                  "index": 3
                },
                "kind": "row",
                "reason": "invalid_entry"
              }
            ],
            "credentials": []
          },
          "match": [
            {
              "pointer": "/format",
              "eq": "yaml"
            },
            {
              "pointer": "/targets/0/source_ref",
              "eq": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaax"
            },
            {
              "pointer": "/targets/0/definition/options/connection_linger",
              "eq": 30
            },
            {
              "pointer": "/not_carried/0/kind",
              "eq": "row"
            },
            {
              "pointer": "/not_carried/0/reason",
              "eq": "invalid_entry"
            },
            {
              "pointer": "/not_carried/0/locator/index",
              "eq": 1
            }
          ],
          "headers": {
            "Cache-Control": "no-store"
          }
        }
      }
    ]
  }
}
