{
  "seam": "C1",
  "name": "session-list-get",
  "mark": {
    "required-green": "e0"
  },
  "kind": "rest",
  "grade": "live",
  "description": "GET /sessions lists the sessions the principal may see and GET /sessions/{id} returns one record; an unknown id is 404 session_not_found. A surface whose client died finds its session again this way: the broker keeps the session, the surface is disposable.",
  "corpus": [
    "Contract §3",
    "Contract §2"
  ],
  "case": {
    "inputs": [
      "user",
      "password",
      "target_id"
    ],
    "steps": [
      {
        "http": {
          "method": "POST",
          "path": "/sessions",
          "body": {
            "target_id": "${target_id}",
            "connection": "new",
            "term": "xterm-256color",
            "cols": 120,
            "rows": 40
          }
        },
        "expect": {
          "status": 201,
          "example": {
            "session": {
              "id": "fixture-session-a",
              "target_id": "fixture-target",
              "connection_id": "fixture-conn-1",
              "session_type": "shell",
              "state": "detached",
              "tier": 1,
              "owner": "fixture-user",
              "control_holder": null,
              "created_at": "2026-09-23T12:00:00Z",
              "term": "xterm-256color",
              "cols": 120,
              "rows": 40,
              "recording": {
                "active": true,
                "warning_code": "recording.active",
                "warning_text": "This session is recorded byte-perfect. Anything typed will be stored as-is."
              }
            }
          }
        },
        "save": {
          "sid": "/session/id"
        }
      },
      {
        "http": {
          "method": "GET",
          "path": "/sessions"
        },
        "expect": {
          "status": 200,
          "match": [
            {
              "pointer": "/sessions",
              "some": {
                "/id": "${sid}"
              }
            }
          ],
          "example": {
            "sessions": [
              {
                "id": "fixture-session-a",
                "target_id": "fixture-target",
                "connection_id": "fixture-conn-1",
                "session_type": "shell",
                "state": "detached",
                "tier": 1,
                "owner": "fixture-user",
                "control_holder": null,
                "created_at": "2026-09-23T12:00:00Z",
                "term": "xterm-256color",
                "cols": 120,
                "rows": 40,
                "recording": {
                  "active": true,
                  "warning_code": "recording.active",
                  "warning_text": "This session is recorded byte-perfect. Anything typed will be stored as-is."
                }
              }
            ]
          }
        }
      },
      {
        "http": {
          "method": "GET",
          "path": "/sessions/${sid}"
        },
        "expect": {
          "status": 200,
          "match": [
            {
              "pointer": "/id",
              "eq": "${sid}"
            },
            {
              "pointer": "/state",
              "eq": "detached"
            }
          ],
          "example": {
            "id": "fixture-session-a",
            "target_id": "fixture-target",
            "connection_id": "fixture-conn-1",
            "session_type": "shell",
            "state": "detached",
            "tier": 1,
            "owner": "fixture-user",
            "control_holder": null,
            "created_at": "2026-09-23T12:00:00Z",
            "term": "xterm-256color",
            "cols": 120,
            "rows": 40,
            "recording": {
              "active": true,
              "warning_code": "recording.active",
              "warning_text": "This session is recorded byte-perfect. Anything typed will be stored as-is."
            }
          }
        }
      },
      {
        "http": {
          "method": "GET",
          "path": "/sessions/fixture-no-such-session"
        },
        "expect": {
          "status": 404,
          "match": [
            {
              "pointer": "/error/code",
              "eq": "session_not_found"
            }
          ],
          "example": {
            "error": {
              "code": "session_not_found",
              "message": "no such session"
            }
          }
        }
      }
    ],
    "cleanup": [
      {
        "method": "DELETE",
        "path": "/sessions/${sid}"
      }
    ]
  }
}
