{
  "seam": "C1",
  "name": "target-write-forbidden-without-permission",
  "mark": {
    "published": "e3",
    "required-green": "e4"
  },
  "kind": "rest",
  "grade": "live",
  "description": "Peer has target.discover but not target.edit; all four operations are forbidden and no target is created.",
  "corpus": [
    "Storage §3.5",
    "Storage §9",
    "Storage §10.1",
    "Contract §4"
  ],
  "case": {
    "inputs": [
      "user",
      "password",
      "peer_user",
      "peer_password",
      "target_id"
    ],
    "steps": [
      {
        "http": {
          "method": "POST",
          "path": "/targets",
          "body": {
            "id": "fixture-w-${nonce}",
            "type": "ssh",
            "host": "192.0.2.60"
          },
          "as": "peer"
        },
        "expect": {
          "status": 403,
          "match": [
            {
              "pointer": "/error/code",
              "eq": "forbidden"
            }
          ],
          "example": {
            "error": {
              "code": "forbidden",
              "message": "target request refused"
            }
          }
        }
      },
      {
        "http": {
          "method": "PUT",
          "path": "/targets/${target_id}",
          "body": {
            "id": "${target_id}",
            "type": "ssh",
            "host": "192.0.2.60"
          },
          "as": "peer"
        },
        "expect": {
          "status": 403,
          "match": [
            {
              "pointer": "/error/code",
              "eq": "forbidden"
            }
          ],
          "example": {
            "error": {
              "code": "forbidden",
              "message": "target request refused"
            }
          }
        }
      },
      {
        "http": {
          "method": "DELETE",
          "path": "/targets/${target_id}",
          "as": "peer"
        },
        "expect": {
          "status": 403,
          "match": [
            {
              "pointer": "/error/code",
              "eq": "forbidden"
            }
          ],
          "example": {
            "error": {
              "code": "forbidden",
              "message": "target request refused"
            }
          }
        }
      },
      {
        "http": {
          "method": "GET",
          "path": "/targets/${target_id}/definition",
          "as": "peer"
        },
        "expect": {
          "status": 403,
          "match": [
            {
              "pointer": "/error/code",
              "eq": "forbidden"
            }
          ],
          "example": {
            "error": {
              "code": "forbidden",
              "message": "target request refused"
            }
          }
        }
      },
      {
        "http": {
          "method": "GET",
          "path": "/targets/fixture-w-${nonce}"
        },
        "expect": {
          "status": 404,
          "match": [
            {
              "pointer": "/error/code",
              "eq": "target_not_found"
            }
          ],
          "example": {
            "error": {
              "code": "target_not_found",
              "message": "target request refused"
            }
          }
        }
      }
    ]
  }
}
