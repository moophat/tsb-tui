{
  "seam": "C1",
  "name": "session-delete",
  "mark": {
    "required-green": "e0"
  },
  "kind": "rest",
  "grade": "live",
  "description": "The owner ends a session with DELETE: 204, and its record then reads killed — ended through TSB, by its owner (session model §12). Closing one session closes that channel only: a sibling session on the same connection stays alive (Contract §15.2 — sessions are independent of each other).",
  "corpus": [
    "Contract §15.2",
    "Contract §10",
    "session model §12",
    "decision 5.45 (killed = by TSB or through it)"
  ],
  "case": {
    "inputs": [
      "user",
      "password",
      "target_id"
    ],
    "steps": [
      {
        "http": {
          "method": "POST",
          "path": "/sessions",
          "body": {
            "target_id": "${target_id}",
            "connection": "new",
            "term": "xterm-256color",
            "cols": 120,
            "rows": 40
          }
        },
        "expect": {
          "status": 201,
          "example": {
            "session": {
              "id": "fixture-session-a",
              "target_id": "fixture-target",
              "connection_id": "fixture-conn-1",
              "session_type": "shell",
              "state": "detached",
              "tier": 1,
              "owner": "fixture-user",
              "control_holder": null,
              "created_at": "2026-09-23T12:00:00Z",
              "term": "xterm-256color",
              "cols": 120,
              "rows": 40,
              "recording": {
                "active": true,
                "warning_code": "recording.active",
                "warning_text": "This session is recorded byte-perfect. Anything typed will be stored as-is."
              }
            }
          }
        },
        "save": {
          "sid_a": "/session/id",
          "conn_a": "/session/connection_id"
        }
      },
      {
        "http": {
          "method": "POST",
          "path": "/sessions",
          "body": {
            "target_id": "${target_id}",
            "connection": "reuse",
            "term": "xterm-256color",
            "cols": 120,
            "rows": 40,
            "connection_id": "${conn_a}"
          }
        },
        "expect": {
          "status": 201,
          "match": [
            {
              "pointer": "/session/connection_id",
              "eq": "${conn_a}"
            }
          ],
          "example": {
            "session": {
              "id": "fixture-session-a",
              "target_id": "fixture-target",
              "connection_id": "fixture-conn-1",
              "session_type": "shell",
              "state": "detached",
              "tier": 1,
              "owner": "fixture-user",
              "control_holder": null,
              "created_at": "2026-09-23T12:00:00Z",
              "term": "xterm-256color",
              "cols": 120,
              "rows": 40,
              "recording": {
                "active": true,
                "warning_code": "recording.active",
                "warning_text": "This session is recorded byte-perfect. Anything typed will be stored as-is."
              }
            }
          }
        },
        "save": {
          "sid_b": "/session/id"
        }
      },
      {
        "http": {
          "method": "DELETE",
          "path": "/sessions/${sid_a}"
        },
        "expect": {
          "status": 204
        }
      },
      {
        "http": {
          "method": "GET",
          "path": "/sessions/${sid_a}"
        },
        "expect": {
          "status": 200,
          "match": [
            {
              "pointer": "/state",
              "eq": "killed"
            }
          ],
          "example": {
            "id": "fixture-session-a",
            "target_id": "fixture-target",
            "connection_id": "fixture-conn-1",
            "session_type": "shell",
            "state": "killed",
            "tier": 1,
            "owner": "fixture-user",
            "control_holder": null,
            "created_at": "2026-09-23T12:00:00Z",
            "term": "xterm-256color",
            "cols": 120,
            "rows": 40,
            "recording": {
              "active": true,
              "warning_code": "recording.active",
              "warning_text": "This session is recorded byte-perfect. Anything typed will be stored as-is."
            }
          }
        }
      },
      {
        "http": {
          "method": "GET",
          "path": "/sessions/${sid_b}"
        },
        "expect": {
          "status": 200,
          "match": [
            {
              "pointer": "/state",
              "eq": "detached"
            },
            {
              "pointer": "/connection_id",
              "eq": "${conn_a}"
            }
          ]
        }
      }
    ],
    "cleanup": [
      {
        "method": "DELETE",
        "path": "/sessions/${sid_b}"
      }
    ]
  }
}
