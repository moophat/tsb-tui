{
  "seam": "C1",
  "name": "credential-choice-same-name-two-layers",
  "mark": {
    "published": "e4",
    "required-green": "e4"
  },
  "kind": "rest",
  "grade": "reference",
  "graded_by": [
    {
      "unit": "U2",
      "test": "owed: U2's handler tests in core/ (against C7, over a fake vault); E4 phase 6 (U2: auth, locks and the vault and device HTTP handlers over a fake vault); the test is named in phase 16"
    }
  ],
  "description": "References are unique within their owner only, so a personal credential and an org credential may share a name: they are two candidates, told apart by their layer (DEFAULT 51). Two grants naming the same org reference are one candidate.",
  "corpus": [
    "Contract §12",
    "Storage §10.4",
    "Storage §10.1a",
    "E4 D8",
    "E4 DEFAULT 51",
    "session-open step 3"
  ],
  "case": {
    "inputs": [
      "user",
      "password",
      "target_id"
    ],
    "steps": [
      {
        "http": {
          "method": "POST",
          "path": "/sessions",
          "body": {
            "target_id": "${target_id}",
            "connection": "new",
            "term": "xterm-256color",
            "cols": 120,
            "rows": 40
          }
        },
        "expect": {
          "status": 409,
          "example": {
            "error": {
              "code": "credential_choice_required",
              "message": "choose a credential",
              "candidates": [
                {
                  "credential_ref": "netops",
                  "credential_layer": "personal"
                },
                {
                  "credential_ref": "netops",
                  "credential_layer": "org"
                }
              ]
            }
          }
        }
      }
    ]
  }
}
