{
  "seam": "C1",
  "name": "credential-choice-made",
  "mark": {
    "published": "e4",
    "required-green": "e4"
  },
  "kind": "rest",
  "grade": "reference",
  "graded_by": [
    {
      "unit": "U2",
      "test": "owed: U2's handler tests in core/ (against C7, over a fake vault); E4 phase 6 (U2: auth, locks and the vault and device HTTP handlers over a fake vault); the test is named in phase 16"
    }
  ],
  "description": "The operator's choice: the create repeated with credential_ref and credential_layer naming a candidate opens the session with that credential, and session.connect records it (C6/event-session-connect-credential). A pair that is not a candidate is 422; a choice with only one of the two fields is not the request's shape.",
  "corpus": [
    "Contract §12",
    "Storage §10.4",
    "Storage §10.1a",
    "E4 D8",
    "E4 DEFAULT 51",
    "session-open step 3"
  ],
  "case": {
    "inputs": [
      "user",
      "password",
      "target_id"
    ],
    "steps": [
      {
        "http": {
          "method": "POST",
          "path": "/sessions",
          "body": {
            "target_id": "${target_id}",
            "connection": "new",
            "term": "xterm-256color",
            "cols": 120,
            "rows": 40,
            "credential_ref": "netops",
            "credential_layer": "personal"
          }
        },
        "expect": {
          "status": 201
        }
      },
      {
        "http": {
          "method": "POST",
          "path": "/sessions",
          "body": {
            "target_id": "${target_id}",
            "connection": "new",
            "term": "xterm-256color",
            "cols": 120,
            "rows": 40,
            "credential_ref": "not-a-candidate",
            "credential_layer": "org"
          }
        },
        "expect": {
          "status": 422,
          "example": {
            "error": {
              "code": "invalid_request",
              "message": "that credential is not a candidate"
            }
          }
        }
      },
      {
        "http": {
          "method": "POST",
          "path": "/sessions",
          "body": {
            "target_id": "${target_id}",
            "connection": "new",
            "term": "xterm-256color",
            "cols": 120,
            "rows": 40,
            "credential_ref": "netops"
          },
          "invalid_body": true
        },
        "expect": {
          "status": 422,
          "example": {
            "error": {
              "code": "invalid_request",
              "message": "credential_ref and credential_layer go together"
            }
          }
        }
      }
    ]
  }
}
