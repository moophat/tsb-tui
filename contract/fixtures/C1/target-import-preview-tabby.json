{
  "seam": "C1",
  "name": "target-import-preview-tabby",
  "mark": {
    "published": "e3b",
    "required-green": "e3b"
  },
  "kind": "rest",
  "grade": "live",
  "description": "Synthetic credential-free tabby export: verify the native reference and sanitized SSH preview. Broader mapping and loss cases remain owed.",
  "corpus": [
    "Storage \u00a77.4",
    "Contract \u00a712"
  ],
  "case": {
    "inputs": [
      "user",
      "password"
    ],
    "steps": [
      {
        "http": {
          "method": "POST",
          "path": "/target-imports",
          "body": {
            "action": "preview",
            "format": "tabby",
            "export_bytes": ""
          }
        },
        "expect": {
          "status": 200,
          "example": {
            "import_id": "imp-aaaaaaaaaaaaaaaaaaaaaaaaaa",
            "preview_token": "fixture_token",
            "format": "tabby",
            "targets": [
              {
                "entry": {
                  "index": 1,
                  "name": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
                },
                "source_ref": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                "target": {
                  "id": "g-aaaaaaaaaaaaaaaaaaaaaaaaaa",
                  "type": "ssh",
                  "name": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                  "tags": [],
                  "discovered_by": "tsb",
                  "host": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                  "port": 22
                },
                "change": "create",
                "n": 0,
                "has_credentials": false,
                "key_file_referenced": false,
                "definition": {
                  "id": "g-aaaaaaaaaaaaaaaaaaaaaaaaaa",
                  "type": "ssh",
                  "name": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                  "discovered_by": "tsb",
                  "options": {
                    "host": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
                  }
                },
                "mapping": null
              }
            ],
            "not_carried": [],
            "credentials": []
          },
          "match": [
            {
              "pointer": "/format",
              "eq": "tabby"
            },
            {
              "pointer": "/targets/0/source_ref",
              "eq": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
            },
            {
              "pointer": "/targets/0/change",
              "eq": "create"
            },
            {
              "pointer": "/targets/0/definition/options/host",
              "eq": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
            },
            {
              "pointer": "",
              "not_contains": [
                "FIXTURE-NOT-A-PASSWORD"
              ]
            },
            {
              "pointer": "/targets/0/target/id",
              "ne": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
            }
          ],
          "headers": {
            "Cache-Control": "no-store"
          }
        }
      }
    ]
  }
}
