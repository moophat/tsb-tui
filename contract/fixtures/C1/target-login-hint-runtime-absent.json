          "path": "/targets?tag=hint-runtime-absent"
        },
        "expect": {
          "status": 200,
          "match": [
            {
              "pointer": "/targets",
              "some": {
                "/id": "hint-runtime-absent"
              }
            },
            {
              "pointer": "/targets/0/login_hint",
              "absent": true
