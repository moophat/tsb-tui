  },
  "kind": "rest",
  "grade": "reference",
  "graded_by": [
    {
      "unit": "U2",
      "test": "owed: Wire list/single-read behavior and runtime/protocol/target-scoped authorization context."
    },
    {
      "unit": "U6",
      "test": "owed: Structural sealed-record health without decryption; metadata existence is not encrypted material validation; unmapped unsealed vault must not poison org-only candidates."
    }
  ],
  "description": "Stored metadata candidate at hint-missing-material produces saved (or contributes to choice_required when another candidate exists), but new create returns no_resolving_credential for missing material even without metadata changes. Unsealed personal record backing a candidate at hint-unsealed produces unavailable; do not silently choose an org alternative. Unmapped unsealed vault alone permits hint-org-only saved. Each named target has an exclusive tag equal to its id; filtered list reads select that row for the field-omission checks.",
  "corpus": [
    "Storage §10.1a",
    "Contract §4",
    "Contract §12",
    "inventory-list caller-relative login hint",
    "session-open step 3"
  ],
  "case": {
    "inputs": [
      "user",
      "password"
    ],
    "steps": [
      {
        "http": {
          "method": "GET",
          "path": "/targets?tag=hint-missing-material"
        },
        "expect": {
          "status": 200,
          "match": [
            {
              "pointer": "/targets",
              "some": {
                "/id": "hint-missing-material",
                "/login_hint": "saved"
              }
            }
          ],
          "example": {
            "targets": [
              {
                "id": "hint-missing-material",
                "type": "ssh",
                "name": "fixture target",
                "group": "lab",
                "tags": [
                  "hint-missing-material"
                ],
                "discovered_by": "manual",
                "last_seen": "2026-10-17T08:30:00Z",
                "host": "192.0.2.10",
                "port": 22,
                "login_hint": "saved"
              }
            ]
          },
          "headers": {
            "Cache-Control": "no-store"
          }
        }
      },
      {
        "http": {
          "method": "GET",
          "path": "/targets/hint-missing-material"
        },
        "expect": {
          "status": 200,
          "match": [
            {
              "pointer": "/id",
              "eq": "hint-missing-material"
            },
            {
              "pointer": "/login_hint",
              "eq": "saved"
            }
          ],
          "example": {
