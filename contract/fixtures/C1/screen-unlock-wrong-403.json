{
  "seam": "C1",
  "name": "screen-unlock-wrong-403",
  "mark": {
    "published": "e4",
    "required-green": "e4"
  },
  "kind": "rest",
  "grade": "reference",
  "graded_by": [
    {
      "unit": "U2",
      "test": "owed: U2's handler tests in core/ (against C7, over a fake vault); E4 phase 6 (U2: auth, locks and the vault and device HTTP handlers over a fake vault); the test is named in phase 16"
    }
  ],
  "description": "A wrong screen-lock password is 403 screen_unlock_failed and the login stays: the same cookie still answers GET /auth/me, and the login's vault unlock is kept; the refusal writes auth.screen_unlock_failed.",
  "corpus": [
    "credential-protection §5.5",
    "Frontend §10.4",
    "E4 DEFAULT 67"
  ],
  "case": {
    "inputs": [
      "user",
      "password"
    ],
    "steps": [
      {
        "http": {
          "method": "POST",
          "path": "/auth/screen-unlock",
          "body": {
            "password": "FIXTURE-WRONG-PASSWORD"
          }
        },
        "expect": {
          "status": 403,
          "example": {
            "error": {
              "code": "screen_unlock_failed",
              "message": "that password is not right"
            }
          }
        }
      },
      {
        "http": {
          "method": "GET",
          "path": "/auth/me"
        },
        "expect": {
          "status": 200,
          "example": {
            "username": "fixture-user",
            "locks": {
              "screen_lock_after": 900,
              "vault_lock_on_idle": true,
              "vault_idle_after": 1800,
              "vault_hard_cap": 28800,
              "activity_interval": 60
            }
          }
        }
      }
    ]
  }
}
