{
  "seam": "C1",
  "name": "output-page",
  "mark": {"published": "e2", "required-green": "e5"},
  "kind": "ws",
  "grade": "live",
  "description": "The Load-more pages endpoint (C1 decision 3; 5.48; F15): GET /sessions/{id}/output?before_seq=N&max_bytes=M returns whole output frames first..last with last = N-1 or the latest the ring holds below N, as application/octet-stream, with TSB-Page-First-Seq, TSB-Page-Last-Seq and TSB-Page-More headers; chaining before_seq backwards walks the ring. The stub acts as a correct e5 provider: its ring holds every output frame, a page selects the frames immediately below before_seq (newest first, up to max_bytes, then back in seq order), More is true when older frames are left unserved, and a page never splits a frame. Published e2 so the web lane may build against it; required green at e5, where a core ring first exists (no core ring at E2).",
  "corpus": ["C1 decision 3", "5.48", "F15"],
  "case": {
    "inputs": ["user", "password", "target_id"],
    "steps": [
      {"http": {"method": "POST", "path": "/sessions", "body": {"target_id": "${target_id}", "connection": "new", "term": "xterm-256color", "cols": 120, "rows": 40}}, "expect": {"status": 201}, "save": {"sid": "/session/id"}},
      {"http": {"method": "POST", "path": "/auth/ws-ticket", "body": {"session_id": "${sid}"}}, "expect": {"status": 200}, "save": {"ta": "/ticket"}},
      {"ws_open": "a", "path": "/ws/attach"},
      {"ws_send": "a", "frame": {"t": "attach", "v": 1, "ticket": "${ta}", "session_id": "${sid}"}},
      {"ws_expect": "a", "frame": {"match": [{"pointer": "/t", "eq": "attached"}], "save": {"client_a": "/client_id"}}},
      {"ws_expect": "a", "frame": {"match": [{"pointer": "/t", "eq": "prefix"}]}},
      {"ws_send": "a", "bytes": "# page-one ${nonce}\r"},
      {"ws_expect": "a", "output_contains": "page-one ${nonce}"},
      {"ws_send": "a", "bytes": "# page-two ${nonce}\r"},
      {"ws_expect": "a", "output_contains": "page-two ${nonce}"},
      {"ws_close": "a"},
      {
        "http": {"method": "GET", "path": "/sessions/${sid}/output?before_seq=1000&max_bytes=4096"},
        "expect": {
          "status": 200,
          "headers": {"TSB-Page-First-Seq": "1", "TSB-Page-More": "false"},
          "binary_body": {"contains": ["page-one ${nonce}", "page-two ${nonce}"]}
        }
      },
      {
        "http": {"method": "GET", "path": "/sessions/${sid}/output?before_seq=2&max_bytes=4096"},
        "expect": {
          "status": 200,
          "headers": {"TSB-Page-First-Seq": "1", "TSB-Page-Last-Seq": "1", "TSB-Page-More": "false"},
          "binary_body": {"contains": ["page-one ${nonce}"], "lacks": ["page-two"]}
        }
      },
      {
        "http": {"method": "GET", "path": "/sessions/${sid}/output?before_seq=1000&max_bytes=1"},
        "expect": {
          "status": 200,
          "headers": {"TSB-Page-First-Seq": "2", "TSB-Page-Last-Seq": "2", "TSB-Page-More": "true"},
          "binary_body": {"contains": ["page-two ${nonce}"], "lacks": ["page-one"]}
        }
      }
    ],
    "cleanup": [{"method": "DELETE", "path": "/sessions/${sid}"}]
  }
}