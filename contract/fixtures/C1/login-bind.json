{
  "seam": "C1",
  "name": "login-bind",
  "mark": {
    "published": "e4",
    "required-green": "e4"
  },
  "kind": "rest",
  "grade": "reference",
  "graded_by": [
    {
      "unit": "U2",
      "test": "owed: U2's handler tests in core/ (against C7, over a fake vault); E4 phase 6 (U2: auth, locks and the vault and device HTTP handlers over a fake vault); the test is named in phase 16"
    },
    {
      "unit": "U6",
      "test": "owed: U6's tests in vault/; E4 phases 7-9 (U6: vault core, device trust, org tier and grants); the test is named in phase 16"
    }
  ],
  "description": "Tie this login to a trusted device, once (DEFAULT 39): after the password login, a login.bind challenge for the device, signed by its key. A device not on the allowlist is 403 device_not_trusted; a login already tied is refused at issue, 409 challenge_failed. A body without a signature is 422.",
  "corpus": [
    "credential-protection Amendment 2026-09-14",
    "credential-protection §5.2",
    "credential-protection §5.3",
    "credential-protection §7.2",
    "device-trust",
    "E4 DEFAULT 39",
    "login"
  ],
  "case": {
    "inputs": [
      "user",
      "password"
    ],
    "steps": [
      {
        "http": {
          "method": "POST",
          "path": "/devices/challenges",
          "body": {
            "operation": "login.bind",
            "device_id": "FIXTURE-DEVICE-ID-AAAAAAAAAAAAAAAAAAAAAAAAA"
          }
        },
        "expect": {
          "status": 200,
          "example": {
            "challenge_id": "ch-0001",
            "challenge": "RklYVFVSRS1DSEFMTEVOR0UtMDAwMDAwMDAwMDAwMDA=",
            "login_handle": "lh-fixture-0001",
            "expires_in": 30
          }
        }
      },
      {
        "http": {
          "method": "POST",
          "path": "/auth/bind",
          "body": {
            "challenge_id": "ch-0001",
            "signature": "RklYVFVSRS1TSUdOQVRVUkUtMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMA=="
          }
        },
        "expect": {
          "status": 204
        }
      },
      {
        "http": {
          "method": "POST",
          "path": "/auth/bind",
          "body": {
            "challenge_id": "ch-0001"
          },
          "invalid_body": true
        },
        "expect": {
          "status": 422,
          "example": {
            "error": {
              "code": "invalid_request",
              "message": "the body is not a bind request"
            }
          }
        }
      }
    ]
  }
}
