{
  "seam": "C1",
  "name": "ws-ticket-mint",
  "mark": {
    "required-green": "e0"
  },
  "kind": "rest",
  "grade": "live",
  "description": "A logged-in principal mints a one-time attach ticket for one session. The response is versioned (v) so a later token format can be told apart, and carries its lifetime. The ticket is the only way to open C2, and it travels in the first WebSocket frame, never in a URL.",
  "corpus": [
    "spine plan.md §3 C1",
    "decision 5.34",
    "decision 5.41",
    "Contract §2"
  ],
  "case": {
    "inputs": [
      "user",
      "password",
      "target_id"
    ],
    "steps": [
      {
        "http": {
          "method": "POST",
          "path": "/sessions",
          "body": {
            "target_id": "${target_id}",
            "connection": "new",
            "term": "xterm-256color",
            "cols": 120,
            "rows": 40
          }
        },
        "expect": {
          "status": 201,
          "example": {
            "session": {
              "id": "fixture-session-a",
              "target_id": "fixture-target",
              "connection_id": "fixture-conn-1",
              "session_type": "shell",
              "state": "detached",
              "tier": 1,
              "owner": "fixture-user",
              "control_holder": null,
              "created_at": "2026-09-23T12:00:00Z",
              "term": "xterm-256color",
              "cols": 120,
              "rows": 40,
              "recording": {
                "active": true,
                "warning_code": "recording.active",
                "warning_text": "This session is recorded byte-perfect. Anything typed will be stored as-is."
              }
            }
          }
        },
        "save": {
          "sid": "/session/id"
        }
      },
      {
        "http": {
          "method": "POST",
          "path": "/auth/ws-ticket",
          "body": {
            "session_id": "${sid}"
          }
        },
        "expect": {
          "status": 200,
          "match": [
            {
              "pointer": "/v",
              "eq": 1
            },
            {
              "pointer": "/ticket",
              "present": true
            },
            {
              "pointer": "/expires_in",
              "present": true
            }
          ],
          "example": {
            "v": 1,
            "ticket": "FIXTURE-TICKET-000000000000000000",
            "expires_in": 30
          }
        }
      }
    ],
    "cleanup": [
      {
        "method": "DELETE",
        "path": "/sessions/${sid}"
      }
    ]
  }
}
