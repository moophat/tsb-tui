{
  "seam": "C1",
  "name": "target-import-preview-yaml",
  "mark": {
    "published": "e3b",
    "required-green": "e3b"
  },
  "kind": "rest",
  "grade": "live",
  "description": "A synthetic single-target YAML preview preserves native reference, tags, vendor and an explicitly empty own prompt. Live execution is owed by U2; a separate provider citation cannot yet be represented for a live fixture.",
  "corpus": [
    "Storage \u00a77.4",
    "Contract \u00a712"
  ],
  "case": {
    "inputs": [
      "user",
      "password"
    ],
    "steps": [
      {
        "http": {
          "method": "POST",
          "path": "/target-imports",
          "body": {
            "action": "preview",
            "format": "yaml",
            "export_bytes": ""
          }
        },
        "expect": {
          "status": 200,
          "example": {
            "import_id": "imp-aaaaaaaaaaaaaaaaaaaaaaaaaa",
            "preview_token": "fixture_token",
            "format": "yaml",
            "targets": [
              {
                "entry": {
                  "index": 1,
                  "name": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
                },
                "source_ref": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                "target": {
                  "id": "g-aaaaaaaaaaaaaaaaaaaaaaaaaa",
                  "type": "ssh",
                  "name": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                  "tags": [
                    "lab"
                  ],
                  "discovered_by": "tsb",
                  "host": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                  "port": 22,
                  "vendor": "cisco",
                  "prompt_pattern": ""
                },
                "change": "create",
                "n": 0,
                "has_credentials": false,
                "key_file_referenced": false,
                "definition": {
                  "id": "g-aaaaaaaaaaaaaaaaaaaaaaaaaa",
                  "type": "ssh",
                  "name": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                  "discovered_by": "tsb",
                  "options": {
                    "host": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
                  },
                  "tags": [
                    "lab"
                  ],
                  "vendor": "cisco",
                  "prompt_pattern": ""
                },
                "mapping": null
              }
            ],
            "not_carried": [],
            "credentials": []
          },
          "match": [
            {
              "pointer": "/format",
              "eq": "yaml"
            },
            {
              "pointer": "/targets/0/source_ref",
              "eq": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
            },
            {
              "pointer": "/targets/0/change",
              "eq": "create"
            },
            {
              "pointer": "/targets/0/definition/tags/0",
              "eq": "lab"
            },
            {
              "pointer": "/targets/0/definition/vendor",
              "eq": "cisco"
            },
            {
              "pointer": "/targets/0/definition/prompt_pattern",
              "eq": ""
            },
            {
              "pointer": "",
              "not_contains": [
                "FIXTURE-NOT-A-PASSWORD"
              ]
            },
            {
              "pointer": "/targets/0/target/id",
              "ne": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
            }
          ],
          "headers": {
            "Cache-Control": "no-store"
