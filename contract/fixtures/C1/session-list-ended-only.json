{
  "seam": "C1",
  "name": "session-list-ended-only",
  "mark": {
    "published": "e4",
    "required-green": "e5"
  },
  "kind": "rest",
  "grade": "reference",
  "graded_by": [
    {
      "unit": "U2",
      "test": "owed: session history session-list-ended-only provider test"
    }
  ],
  "description": "Seed the same visible killed, terminated, detached and live records as session-list-paged. only is exactly the ended-state complement of exclude; filter before filling. Later end states follow the common state registry. Assert the same selection without limit and with continuation. Published e4 so surfaces can build against the shape; required-green e5 so the addition does not retroactively fail the existing e4 provider. A full final page may carry next_cursor; when present, follow it and assert an empty page without next_cursor. No look-ahead is required.",
  "corpus": [
    "session-list rules 8\u201310",
    "conventions V1, V4, V7, V8",
    "Storage \u00a78.6"
  ],
  "case": {
    "inputs": [
      "user",
      "password"
    ],
    "steps": [
      {
        "http": {
          "method": "GET",
          "path": "/sessions?ended=only&limit=1"
        },
        "expect": {
          "status": 200,
          "match": [
            {
              "pointer": "/sessions/0/id",
              "eq": "fixture-history-z"
            },
            {
              "pointer": "/next_cursor",
              "present": true
            },
            {
              "pointer": "/sessions/1",
              "absent": true
            }
          ],
          "example": {
            "sessions": [
              {
                "id": "fixture-history-z",
                "target_id": "fixture-target",
                "connection_id": "fixture-conn-1",
                "session_type": "shell",
                "state": "killed",
                "tier": 1,
                "owner": "fixture-user",
                "control_holder": null,
                "created_at": "2026-11-16T12:00:00Z",
                "term": "xterm-256color",
                "cols": 120,
                "rows": 40,
                "recording": {
                  "active": true,
                  "warning_code": "recording.active",
                  "warning_text": "This session is recorded byte-perfect. Anything typed will be stored as-is."
                }
              }
            ],
            "next_cursor": "fixture-opaque-history-position"
          }
        },
        "save": {
          "cursor": "/next_cursor"
        }
      },
      {
        "http": {
          "method": "GET",
          "path": "/sessions?ended=only&limit=1&cursor=${cursor}"
        },
        "expect": {
          "status": 200,
          "match": [
            {
              "pointer": "/sessions/0/id",
              "eq": "fixture-history-b"
            },
            {
              "pointer": "/sessions/1",
              "absent": true
            }
          ],
          "example": {
