{
  "seam": "C2",
  "name": "token-owner-revoke-reassign",
  "mark": {"required-green": "e2"},
  "kind": "ws",
  "grade": "live",
  "description": "The owner revokes and reassigns the control token (C2 decision 6, PTY §7.1). A peer client holds the token; an owner client sends `handoff` with `to` null — the token goes to escrow, holder null. Both detach, leaving no client and the token in escrow. A peer reattaches while the token is in escrow and does not take it (an attach does not take an escrowed token): its session shows control_holder null. The owner then reassigns it to that client with `handoff` to its client_id. Needs a peer login with session.join.rw (inputs peer_user, peer_password).",
  "corpus": ["C2 decision 6", "PTY §7.1", "Contract §10", "immortality §7"],
  "case": {
    "inputs": ["user", "password", "target_id", "peer_user", "peer_password"],
    "steps": [
      {"http": {"method": "POST", "path": "/sessions", "body": {"target_id": "${target_id}", "connection": "new", "term": "xterm-256color", "cols": 120, "rows": 40}}, "expect": {"status": 201}, "save": {"sid": "/session/id"}},
      {"http": {"method": "POST", "path": "/auth/ws-ticket", "body": {"session_id": "${sid}"}, "as": "peer"}, "expect": {"status": 200}, "save": {"tp": "/ticket"}},
      {"ws_open": "p", "path": "/ws/attach"},
      {"ws_send": "p", "frame": {"t": "attach", "v": 1, "ticket": "${tp}", "session_id": "${sid}"}},
      {"ws_expect": "p", "frame": {"match": [{"pointer": "/t", "eq": "attached"}, {"pointer": "/session/control_holder/user", "eq": "${peer_user}"}], "save": {"client_p": "/client_id"}}},
      {"ws_expect": "p", "prefix": {"match": [{"pointer": "/t", "eq": "prefix"}]}},
      {"ws_expect": "p", "frame": {"match": [{"pointer": "/t", "eq": "clients"}]}},
      {"http": {"method": "POST", "path": "/auth/ws-ticket", "body": {"session_id": "${sid}"}}, "expect": {"status": 200}, "save": {"to": "/ticket"}},
      {"ws_open": "o", "path": "/ws/attach"},
      {"ws_send": "o", "frame": {"t": "attach", "v": 1, "ticket": "${to}", "session_id": "${sid}"}},
      {"ws_expect": "o", "frame": {"match": [{"pointer": "/t", "eq": "attached"}, {"pointer": "/session/control_holder/client_id", "eq": "${client_p}"}], "save": {"client_o": "/client_id"}}},
      {"ws_expect": "o", "prefix": {"match": [{"pointer": "/t", "eq": "prefix"}]}},
      {"ws_expect": "o", "frame": {"match": [{"pointer": "/t", "eq": "clients"}]}},
      {"ws_expect": "p", "frame": {"match": [{"pointer": "/t", "eq": "clients"}]}},
      {"ws_send": "o", "frame": {"t": "handoff", "v": 1, "to": null}},
      {"ws_expect": "o", "frame": {"match": [{"pointer": "/t", "eq": "token"}, {"pointer": "/reason", "eq": "owner"}, {"pointer": "/holder", "eq": null}]}},
      {"ws_expect": "p", "frame": {"match": [{"pointer": "/t", "eq": "token"}, {"pointer": "/holder", "eq": null}]}},
      {"ws_close": "o"},
      {"ws_close": "p"},
      {"http": {"method": "POST", "path": "/auth/ws-ticket", "body": {"session_id": "${sid}"}, "as": "peer"}, "expect": {"status": 200}, "save": {"tp2": "/ticket"}},
      {"ws_open": "p2", "path": "/ws/attach"},
      {"ws_send": "p2", "frame": {"t": "attach", "v": 1, "ticket": "${tp2}", "session_id": "${sid}"}},
      {"ws_expect": "p2", "frame": {"match": [{"pointer": "/t", "eq": "attached"}, {"pointer": "/session/control_holder", "eq": null}], "save": {"client_p2": "/client_id"}}},
      {"ws_expect": "p2", "prefix": {"match": [{"pointer": "/t", "eq": "prefix"}]}},
      {"ws_expect": "p2", "frame": {"match": [{"pointer": "/t", "eq": "clients"}]}},
      {"http": {"method": "POST", "path": "/auth/ws-ticket", "body": {"session_id": "${sid}"}}, "expect": {"status": 200}, "save": {"to2": "/ticket"}},
      {"ws_open": "o2", "path": "/ws/attach"},
      {"ws_send": "o2", "frame": {"t": "attach", "v": 1, "ticket": "${to2}", "session_id": "${sid}"}},
      {"ws_expect": "o2", "frame": {"match": [{"pointer": "/t", "eq": "attached"}, {"pointer": "/session/control_holder", "eq": null}], "save": {"client_o2": "/client_id"}}},
      {"ws_expect": "o2", "prefix": {"match": [{"pointer": "/t", "eq": "prefix"}]}},
      {"ws_expect": "o2", "frame": {"match": [{"pointer": "/t", "eq": "clients"}]}},
      {"ws_expect": "p2", "frame": {"match": [{"pointer": "/t", "eq": "clients"}]}},
      {"ws_send": "o2", "frame": {"t": "handoff", "v": 1, "to": "${client_p2}"}},
      {"ws_expect": "o2", "frame": {"match": [{"pointer": "/t", "eq": "token"}, {"pointer": "/reason", "eq": "owner"}, {"pointer": "/holder/client_id", "eq": "${client_p2}"}]}},
      {"ws_expect": "p2", "frame": {"match": [{"pointer": "/t", "eq": "token"}, {"pointer": "/holder/client_id", "eq": "${client_p2}"}]}},
      {"ws_close": "p2"},
      {"ws_close": "o2"}
    ],
    "cleanup": [{"method": "DELETE", "path": "/sessions/${sid}"}]
  }
}