{
  "seam": "C2",
  "name": "owner-takeover-by-typing",
  "mark": {"required-green": "e2"},
  "kind": "ws",
  "grade": "live",
  "description": "Taking the keyboard back by typing (C2 decision 6, 5.53): a peer holds the token; the owner's client sends input while it is not the holder, and the token moves to it in the same trip — the owner gets a `token` frame reason `takeover`, the owner's bytes reach the target, and the peer's next input is refused `input_refused` reason `not_typist` — never two typists. Needs a peer login with session.join.rw (inputs peer_user, peer_password).",
  "corpus": ["C2 decision 6", "5.53", "Contract §10", "terminal-size-and-control.md §5–§6"],
  "case": {
    "inputs": ["user", "password", "target_id", "peer_user", "peer_password"],
    "steps": [
      {"http": {"method": "POST", "path": "/sessions", "body": {"target_id": "${target_id}", "connection": "new", "term": "xterm-256color", "cols": 120, "rows": 40}}, "expect": {"status": 201}, "save": {"sid": "/session/id"}},
      {"http": {"method": "POST", "path": "/auth/ws-ticket", "body": {"session_id": "${sid}"}}, "expect": {"status": 200}, "save": {"ta": "/ticket"}},
      {"ws_open": "o", "path": "/ws/attach"},
      {"ws_send": "o", "frame": {"t": "attach", "v": 1, "ticket": "${ta}", "session_id": "${sid}"}},
      {"ws_expect": "o", "frame": {"match": [{"pointer": "/t", "eq": "attached"}], "save": {"client_o": "/client_id"}}},
      {"ws_expect": "o", "prefix": {"match": [{"pointer": "/t", "eq": "prefix"}]}},
      {"ws_expect": "o", "frame": {"match": [{"pointer": "/t", "eq": "clients"}]}},
      {"http": {"method": "POST", "path": "/auth/ws-ticket", "body": {"session_id": "${sid}"}, "as": "peer"}, "expect": {"status": 200}, "save": {"tp": "/ticket"}},
      {"ws_open": "p", "path": "/ws/attach"},
      {"ws_send": "p", "frame": {"t": "attach", "v": 1, "ticket": "${tp}", "session_id": "${sid}"}},
      {"ws_expect": "p", "frame": {"match": [{"pointer": "/t", "eq": "attached"}], "save": {"client_p": "/client_id"}}},
      {"ws_expect": "p", "prefix": {"match": [{"pointer": "/t", "eq": "prefix"}]}},
      {"ws_expect": "p", "frame": {"match": [{"pointer": "/t", "eq": "clients"}]}},
      {"ws_expect": "o", "frame": {"match": [{"pointer": "/t", "eq": "clients"}]}},
      {"ws_send": "o", "frame": {"t": "handoff", "v": 1, "to": "${client_p}"}},
      {"ws_expect": "o", "frame": {"match": [{"pointer": "/t", "eq": "token"}, {"pointer": "/holder/client_id", "eq": "${client_p}"}]}},
      {"ws_expect": "p", "frame": {"match": [{"pointer": "/t", "eq": "token"}, {"pointer": "/holder/client_id", "eq": "${client_p}"}]}},
      {"ws_send": "o", "bytes": "# owner-types ${nonce}\r"},
      {"ws_expect": "o", "frame": {"match": [{"pointer": "/t", "eq": "token"}, {"pointer": "/reason", "eq": "takeover"}, {"pointer": "/holder/client_id", "eq": "${client_o}"}]}},
      {"ws_expect": "p", "frame": {"match": [{"pointer": "/t", "eq": "token"}, {"pointer": "/reason", "eq": "takeover"}, {"pointer": "/holder/client_id", "eq": "${client_o}"}]}},
      {"ws_expect": "o", "output_contains": "owner-types ${nonce}"},
      {"ws_send": "p", "bytes": "# peer-late ${nonce}\r"},
      {"ws_expect": "p", "frame": {"match": [{"pointer": "/t", "eq": "input_refused"}, {"pointer": "/reason", "eq": "not_typist"}]}},
      {"ws_close": "p"},
      {"ws_close": "o"}
    ],
    "cleanup": [{"method": "DELETE", "path": "/sessions/${sid}"}]
  }
}