{
  "seam": "C2",
  "name": "attach-ticket-wrong-session-close-4003",
  "mark": {
    "required-green": "e0"
  },
  "kind": "ws",
  "grade": "live",
  "description": "A ticket is bound to (principal, session). One minted for session A and presented for session B is refused with 4003, so a ticket for a session its holder may join never opens another one.",
  "corpus": [
    "decision 5.34",
    "spine plan.md §3 C1"
  ],
  "case": {
    "inputs": [
      "user",
      "password",
      "target_id"
    ],
    "steps": [
      {
        "http": {
          "method": "POST",
          "path": "/sessions",
          "body": {
            "target_id": "${target_id}",
            "connection": "new",
            "term": "xterm-256color",
            "cols": 120,
            "rows": 40
          }
        },
        "expect": {
          "status": 201,
          "example": {
            "session": {
              "id": "fixture-session-a",
              "target_id": "fixture-target",
              "connection_id": "fixture-conn-1",
              "session_type": "shell",
              "state": "detached",
              "tier": 1,
              "owner": "fixture-user",
              "control_holder": null,
              "created_at": "2026-09-23T12:00:00Z",
              "term": "xterm-256color",
              "cols": 120,
              "rows": 40,
              "recording": {
                "active": true,
                "warning_code": "recording.active",
                "warning_text": "This session is recorded byte-perfect. Anything typed will be stored as-is."
              }
            }
          }
        },
        "save": {
          "sid_a": "/session/id"
        }
      },
      {
        "http": {
          "method": "POST",
          "path": "/sessions",
          "body": {
            "target_id": "${target_id}",
            "connection": "new",
            "term": "xterm-256color",
            "cols": 120,
            "rows": 40
          }
        },
        "expect": {
          "status": 201,
          "example": {
            "session": {
              "id": "fixture-session-a",
              "target_id": "fixture-target",
              "connection_id": "fixture-conn-1",
              "session_type": "shell",
              "state": "detached",
              "tier": 1,
              "owner": "fixture-user",
              "control_holder": null,
              "created_at": "2026-09-23T12:00:00Z",
              "term": "xterm-256color",
              "cols": 120,
              "rows": 40,
              "recording": {
                "active": true,
                "warning_code": "recording.active",
                "warning_text": "This session is recorded byte-perfect. Anything typed will be stored as-is."
              }
            }
          }
        },
        "save": {
          "sid_b": "/session/id"
        }
      },
      {
        "http": {
          "method": "POST",
          "path": "/auth/ws-ticket",
          "body": {
            "session_id": "${sid_a}"
          }
        },
        "expect": {
          "status": 200,
          "example": {
            "v": 1,
            "ticket": "FIXTURE-TICKET-000000000000000000",
            "expires_in": 30
          }
        },
        "save": {
          "minted": "/ticket"
        }
      },
      {
        "ws_open": "w",
        "path": "/ws/attach"
      },
      {
        "ws_send": "w",
        "frame": {
          "t": "attach",
          "v": 1,
          "ticket": "${minted}",
          "session_id": "${sid_b}"
        }
      },
      {
        "ws_expect": "w",
        "close": 4003
      }
    ],
    "cleanup": [
      {
        "method": "DELETE",
        "path": "/sessions/${sid_a}"
      },
      {
        "method": "DELETE",
        "path": "/sessions/${sid_b}"
      }
    ]
  }
}
