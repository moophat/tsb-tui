{
  "seam": "C2",
  "name": "token-handoff",
  "mark": {"required-green": "e2"},
  "kind": "ws",
  "grade": "live",
  "description": "Explicit hand-off (C2 decision 6, PTY §7.1): the holder hands the control token to another attached client with a `handoff` frame, and both clients get a `token` frame with reason `handoff` naming the destination as holder. After the move only the new holder's input reaches the target; a non-holder peer's input is refused `not_typist`. Needs a peer login with session.join.rw (inputs peer_user, peer_password); two peer clients attach so the refusal is not the owner's take-over by typing.",
  "corpus": ["C2 decision 6", "PTY §7.1", "Contract §10", "5.53"],
  "case": {
    "inputs": ["user", "password", "target_id", "peer_user", "peer_password"],
    "steps": [
      {"http": {"method": "POST", "path": "/sessions", "body": {"target_id": "${target_id}", "connection": "new", "term": "xterm-256color", "cols": 120, "rows": 40}}, "expect": {"status": 201}, "save": {"sid": "/session/id"}},
      {"http": {"method": "POST", "path": "/auth/ws-ticket", "body": {"session_id": "${sid}"}}, "expect": {"status": 200}, "save": {"ta": "/ticket"}},
      {"ws_open": "a", "path": "/ws/attach"},
      {"ws_send": "a", "frame": {"t": "attach", "v": 1, "ticket": "${ta}", "session_id": "${sid}"}},
      {"ws_expect": "a", "frame": {"match": [{"pointer": "/t", "eq": "attached"}, {"pointer": "/session/control_holder/user", "eq": "${user}"}], "save": {"client_a": "/client_id"}}},
      {"ws_expect": "a", "prefix": {"match": [{"pointer": "/t", "eq": "prefix"}]}},
      {"ws_expect": "a", "frame": {"match": [{"pointer": "/t", "eq": "clients"}]}},
      {"http": {"method": "POST", "path": "/auth/ws-ticket", "body": {"session_id": "${sid}"}, "as": "peer"}, "expect": {"status": 200}, "save": {"tp1": "/ticket"}},
      {"ws_open": "p1", "path": "/ws/attach"},
      {"ws_send": "p1", "frame": {"t": "attach", "v": 1, "ticket": "${tp1}", "session_id": "${sid}"}},
      {"ws_expect": "p1", "frame": {"match": [{"pointer": "/t", "eq": "attached"}, {"pointer": "/session/control_holder/client_id", "eq": "${client_a}"}], "save": {"client_p1": "/client_id"}}},
      {"ws_expect": "p1", "prefix": {"match": [{"pointer": "/t", "eq": "prefix"}]}},
      {"ws_expect": "p1", "frame": {"match": [{"pointer": "/t", "eq": "clients"}]}},
      {"ws_expect": "a", "frame": {"match": [{"pointer": "/t", "eq": "clients"}]}},
      {"http": {"method": "POST", "path": "/auth/ws-ticket", "body": {"session_id": "${sid}"}, "as": "peer"}, "expect": {"status": 200}, "save": {"tp2": "/ticket"}},
      {"ws_open": "p2", "path": "/ws/attach"},
      {"ws_send": "p2", "frame": {"t": "attach", "v": 1, "ticket": "${tp2}", "session_id": "${sid}"}},
      {"ws_expect": "p2", "frame": {"match": [{"pointer": "/t", "eq": "attached"}, {"pointer": "/session/control_holder/client_id", "eq": "${client_a}"}], "save": {"client_p2": "/client_id"}}},
      {"ws_expect": "p2", "prefix": {"match": [{"pointer": "/t", "eq": "prefix"}]}},
      {"ws_expect": "p2", "frame": {"match": [{"pointer": "/t", "eq": "clients"}]}},
      {"ws_expect": "a", "frame": {"match": [{"pointer": "/t", "eq": "clients"}]}},
      {"ws_expect": "p1", "frame": {"match": [{"pointer": "/t", "eq": "clients"}]}},
      {"ws_send": "a", "frame": {"t": "handoff", "v": 1, "to": "${client_p1}"}},
      {"ws_expect": "a", "frame": {"match": [{"pointer": "/t", "eq": "token"}, {"pointer": "/reason", "eq": "handoff"}, {"pointer": "/holder/client_id", "eq": "${client_p1}"}]}},
      {"ws_expect": "p1", "frame": {"match": [{"pointer": "/t", "eq": "token"}, {"pointer": "/reason", "eq": "handoff"}, {"pointer": "/holder/client_id", "eq": "${client_p1}"}]}},
      {"ws_expect": "p2", "frame": {"match": [{"pointer": "/t", "eq": "token"}, {"pointer": "/holder/client_id", "eq": "${client_p1}"}]}},
      {"ws_send": "p2", "bytes": "# refused ${nonce}\r"},
      {"ws_expect": "p2", "frame": {"match": [{"pointer": "/t", "eq": "input_refused"}, {"pointer": "/reason", "eq": "not_typist"}]}},
      {"ws_send": "p1", "bytes": "# reaches ${nonce}\r"},
      {"ws_expect": "p1", "output_contains": "reaches ${nonce}"},
      {"ws_close": "p2"},
      {"ws_close": "p1"},
      {"ws_close": "a"}
    ],
    "cleanup": [{"method": "DELETE", "path": "/sessions/${sid}"}]
  }
}