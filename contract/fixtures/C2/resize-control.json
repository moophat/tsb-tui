{
  "seam": "C2",
  "name": "resize-control",
  "mark": {
    "required-green": "e0"
  },
  "kind": "ws",
  "grade": "live",
  "description": "resize is the one client-to-server control frame at v0.1. From the control-token holder it sets the session's size, which GET /sessions/{id} then reports (resize is out-of-band: surface → core control channel → worker).",
  "corpus": [
    "lang-arch §3.2",
    "lang-arch §7.2",
    "Contract §10",
    "PTY §7.2"
  ],
  "case": {
    "inputs": [
      "user",
      "password",
      "target_id"
    ],
    "steps": [
      {
        "http": {
          "method": "POST",
          "path": "/sessions",
          "body": {
            "target_id": "${target_id}",
            "connection": "new",
            "term": "xterm-256color",
            "cols": 120,
            "rows": 40
          }
        },
        "expect": {
          "status": 201,
          "example": {
            "session": {
              "id": "fixture-session-a",
              "target_id": "fixture-target",
              "connection_id": "fixture-conn-1",
              "session_type": "shell",
              "state": "detached",
              "tier": 1,
              "owner": "fixture-user",
              "control_holder": null,
              "created_at": "2026-09-23T12:00:00Z",
              "term": "xterm-256color",
              "cols": 120,
              "rows": 40,
              "recording": {
                "active": true,
                "warning_code": "recording.active",
                "warning_text": "This session is recorded byte-perfect. Anything typed will be stored as-is."
              }
            }
          }
        },
        "save": {
          "sid": "/session/id"
        }
      },
      {
        "http": {
          "method": "POST",
          "path": "/auth/ws-ticket",
          "body": {
            "session_id": "${sid}"
          }
        },
        "expect": {
          "status": 200,
          "example": {
            "v": 1,
            "ticket": "FIXTURE-TICKET-000000000000000000",
            "expires_in": 30
          }
        },
        "save": {
          "minted": "/ticket"
        }
      },
      {
        "ws_open": "w",
        "path": "/ws/attach"
      },
      {
        "ws_send": "w",
        "frame": {
          "t": "attach",
          "v": 1,
          "ticket": "${minted}",
          "session_id": "${sid}"
        }
      },
      {
        "ws_expect": "w",
        "frame": {
          "match": [
            {
              "pointer": "/t",
              "eq": "attached"
            },
            {
              "pointer": "/session/id",
              "eq": "${sid}"
            }
          ],
          "example": {
            "t": "attached",
            "v": 1,
            "client_id": "fixture-client-1",
            "session": {
              "id": "fixture-session-a",
              "target_id": "fixture-target",
              "connection_id": "fixture-conn-1",
              "session_type": "shell",
              "state": "live",
              "tier": 1,
              "owner": "fixture-user",
              "control_holder": {
                "client_id": "fixture-client-1",
                "user": "fixture-user"
              },
              "created_at": "2026-09-23T12:00:00Z",
              "term": "xterm-256color",
              "cols": 120,
              "rows": 40,
              "recording": {
                "active": true,
                "warning_code": "recording.active",
                "warning_text": "This session is recorded byte-perfect. Anything typed will be stored as-is."
              }
            }
          }
        }
      },
      {
        "ws_send": "w",
        "frame": {
          "t": "resize",
          "v": 1,
          "cols": 100,
          "rows": 30
        }
      },
      {
        "http": {
          "method": "GET",
          "path": "/sessions/${sid}"
        },
        "poll": true,
        "expect": {
          "status": 200,
          "match": [
            {
              "pointer": "/cols",
              "eq": 100
            },
            {
              "pointer": "/rows",
              "eq": 30
            }
          ]
        }
      },
      {
        "ws_close": "w"
      }
    ],
    "cleanup": [
      {
        "method": "DELETE",
        "path": "/sessions/${sid}"
      }
    ]
  }
}
