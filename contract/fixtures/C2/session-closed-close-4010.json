{
  "seam": "C2",
  "name": "session-closed-close-4010",
  "mark": {
    "required-green": "e0"
  },
  "kind": "ws",
  "grade": "live",
  "description": "When the session is killed — ended by TSB or through it, here by its owner's DELETE — an attached client learns it as a WebSocket close with code 4010 session_closed and a reason; an end from outside TSB is 4012 (session-ended-unexpectedly). GET /sessions/{id} gives the rest. There is no state frame at v0.1.",
  "corpus": [
    "spine plan.md §3 C2",
    "session model §12",
    "decision 5.45"
  ],
  "case": {
    "inputs": [
      "user",
      "password",
      "target_id"
    ],
    "steps": [
      {
        "http": {
          "method": "POST",
          "path": "/sessions",
          "body": {
            "target_id": "${target_id}",
            "connection": "new",
            "term": "xterm-256color",
            "cols": 120,
            "rows": 40
          }
        },
        "expect": {
          "status": 201,
          "example": {
            "session": {
              "id": "fixture-session-a",
              "target_id": "fixture-target",
              "connection_id": "fixture-conn-1",
              "session_type": "shell",
              "state": "detached",
              "tier": 1,
              "owner": "fixture-user",
              "control_holder": null,
              "created_at": "2026-09-23T12:00:00Z",
              "term": "xterm-256color",
              "cols": 120,
              "rows": 40,
              "recording": {
                "active": true,
                "warning_code": "recording.active",
                "warning_text": "This session is recorded byte-perfect. Anything typed will be stored as-is."
              }
            }
          }
        },
        "save": {
          "sid": "/session/id"
        }
      },
      {
        "http": {
          "method": "POST",
          "path": "/auth/ws-ticket",
          "body": {
            "session_id": "${sid}"
          }
        },
        "expect": {
          "status": 200,
          "example": {
            "v": 1,
            "ticket": "FIXTURE-TICKET-000000000000000000",
            "expires_in": 30
          }
        },
        "save": {
          "minted": "/ticket"
        }
      },
      {
        "ws_open": "w",
        "path": "/ws/attach"
      },
      {
        "ws_send": "w",
        "frame": {
          "t": "attach",
          "v": 1,
          "ticket": "${minted}",
          "session_id": "${sid}"
        }
      },
      {
        "ws_expect": "w",
        "frame": {
          "match": [
            {
              "pointer": "/t",
              "eq": "attached"
            },
            {
              "pointer": "/session/id",
              "eq": "${sid}"
            }
          ],
          "example": {
            "t": "attached",
            "v": 1,
            "client_id": "fixture-client-1",
            "session": {
              "id": "fixture-session-a",
              "target_id": "fixture-target",
              "connection_id": "fixture-conn-1",
              "session_type": "shell",
              "state": "live",
              "tier": 1,
              "owner": "fixture-user",
              "control_holder": {
                "client_id": "fixture-client-1",
                "user": "fixture-user"
              },
              "created_at": "2026-09-23T12:00:00Z",
              "term": "xterm-256color",
              "cols": 120,
              "rows": 40,
              "recording": {
                "active": true,
                "warning_code": "recording.active",
                "warning_text": "This session is recorded byte-perfect. Anything typed will be stored as-is."
              }
            }
          }
        }
      },
      {
        "http": {
          "method": "DELETE",
          "path": "/sessions/${sid}"
        },
        "expect": {
          "status": 204
        }
      },
      {
        "ws_expect": "w",
        "close": 4010
      }
    ]
  }
}
