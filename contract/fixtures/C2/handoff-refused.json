{
  "seam": "C2",
  "name": "handoff-refused",
  "mark": {"required-green": "e2"},
  "kind": "ws",
  "grade": "live",
  "description": "A refused hand-off answers `request_refused` (C2 decision 6, D7): a non-holder non-owner client asking to hand off is `not_allowed`; a destination client_id naming no attached client is `no_such_client`; a destination holding only session.join.ro is `view_only` (it may never hold the token). Needs a peer login with session.join.rw (inputs peer_user, peer_password) and the viewer login (inputs viewer_user, viewer_password), which the deploy template seeds with session.join.ro only.",
  "corpus": ["C2 decision 6", "C2 decision 7", "PTY §7.1"],
  "case": {
    "inputs": ["user", "password", "target_id", "peer_user", "peer_password", "viewer_user", "viewer_password"],
    "steps": [
      {"http": {"method": "POST", "path": "/sessions", "body": {"target_id": "${target_id}", "connection": "new", "term": "xterm-256color", "cols": 120, "rows": 40}}, "expect": {"status": 201}, "save": {"sid": "/session/id"}},
      {"http": {"method": "POST", "path": "/auth/ws-ticket", "body": {"session_id": "${sid}"}}, "expect": {"status": 200}, "save": {"ta": "/ticket"}},
      {"ws_open": "a", "path": "/ws/attach"},
      {"ws_send": "a", "frame": {"t": "attach", "v": 1, "ticket": "${ta}", "session_id": "${sid}"}},
      {"ws_expect": "a", "frame": {"match": [{"pointer": "/t", "eq": "attached"}], "save": {"client_a": "/client_id"}}},
      {"ws_expect": "a", "prefix": {"match": [{"pointer": "/t", "eq": "prefix"}]}},
      {"ws_expect": "a", "frame": {"match": [{"pointer": "/t", "eq": "clients"}]}},
      {"http": {"method": "POST", "path": "/auth/ws-ticket", "body": {"session_id": "${sid}"}, "as": "peer"}, "expect": {"status": 200}, "save": {"tp": "/ticket"}},
      {"ws_open": "p", "path": "/ws/attach"},
      {"ws_send": "p", "frame": {"t": "attach", "v": 1, "ticket": "${tp}", "session_id": "${sid}"}},
      {"ws_expect": "p", "frame": {"match": [{"pointer": "/t", "eq": "attached"}], "save": {"client_p": "/client_id"}}},
      {"ws_expect": "p", "prefix": {"match": [{"pointer": "/t", "eq": "prefix"}]}},
      {"ws_expect": "p", "frame": {"match": [{"pointer": "/t", "eq": "clients"}]}},
      {"ws_expect": "a", "frame": {"match": [{"pointer": "/t", "eq": "clients"}]}},
      {"http": {"method": "POST", "path": "/auth/login", "as": "fresh", "body": {"username": "${viewer_user}", "password": "${viewer_password}"}}, "expect": {"status": 200}},
      {"http": {"method": "POST", "path": "/auth/ws-ticket", "as": "fresh", "body": {"session_id": "${sid}"}}, "expect": {"status": 200}, "save": {"tv": "/ticket"}},
      {"ws_open": "v", "path": "/ws/attach"},
      {"ws_send": "v", "frame": {"t": "attach", "v": 1, "ticket": "${tv}", "session_id": "${sid}"}},
      {"ws_expect": "v", "frame": {"match": [{"pointer": "/t", "eq": "attached"}, {"pointer": "/session/control_holder/user", "eq": "${user}"}], "save": {"client_v": "/client_id"}}},
      {"ws_expect": "v", "prefix": {"match": [{"pointer": "/t", "eq": "prefix"}]}},
      {"ws_expect": "v", "frame": {"match": [{"pointer": "/t", "eq": "clients"}, {"pointer": "/clients", "some": {"/client_id": "${client_v}", "/may_control": false}}]}},
      {"ws_expect": "a", "frame": {"match": [{"pointer": "/t", "eq": "clients"}]}},
      {"ws_expect": "p", "frame": {"match": [{"pointer": "/t", "eq": "clients"}]}},
      {"ws_send": "p", "frame": {"t": "handoff", "v": 1, "to": "${client_a}"}},
      {"ws_expect": "p", "frame": {"match": [{"pointer": "/t", "eq": "request_refused"}, {"pointer": "/request", "eq": "handoff"}, {"pointer": "/reason", "eq": "not_allowed"}]}},
      {"ws_send": "a", "frame": {"t": "handoff", "v": 1, "to": "${client_v}"}},
      {"ws_expect": "a", "frame": {"match": [{"pointer": "/t", "eq": "request_refused"}, {"pointer": "/request", "eq": "handoff"}, {"pointer": "/reason", "eq": "view_only"}]}},
      {"ws_send": "a", "frame": {"t": "handoff", "v": 1, "to": "fixture-client-gone"}},
      {"ws_expect": "a", "frame": {"match": [{"pointer": "/t", "eq": "request_refused"}, {"pointer": "/request", "eq": "handoff"}, {"pointer": "/reason", "eq": "no_such_client"}]}},
      {"ws_close": "v"},
      {"ws_close": "p"},
      {"ws_close": "a"}
    ],
    "cleanup": [{"method": "DELETE", "path": "/sessions/${sid}"}]
  }
}