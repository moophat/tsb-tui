  "kind": "instance",
  "grade": "reference",
  "graded_by": [
    {
      "unit": "U2",
      "test": "core/internal/audit/audit_test.go — TestSessionConnectSaysPromptedAndRefusedAttempts"
    }
  ],
  "description": "`session.connect` for a session opened by a device login: `detail.login` is `prompted`; `login_recorded` is true exactly when login frames were written at the head of the recording (the knob on and consent given); `refused_attempts` is the number of distinct attempt numbers the core relayed an answer for that are below the highest attempt the device login saw, written when it is at least 1 (derived 9: a guessing record that would otherwise miss guesses that ended in success). A session on a reused prompted connection writes `prompted`, `login_recorded` false and no `refused_attempts`. A `session.connect` rebuilt at a restart cannot carry `refused_attempts`, which is not persisted: the one place a rebuilt line differs from the live one. Never a value.",
  "corpus": [
    "open_decisions §5",
    "credential §10.1",
    "Storage §6",
    "device-login step 20",
    "session-open step 19"
  ],
  "case": {
