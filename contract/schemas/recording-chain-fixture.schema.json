{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recording chain reader case",
  "type": "object",
  "required": [
    "session_id",
    "pairs",
    "audit",
    "audit_complete",
    "expected_error"
  ],
  "additionalProperties": false,
  "properties": {
    "session_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "pairs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "ttyrec_hex",
          "sidecar_hex"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "ttyrec_hex": {
            "type": "string",
            "pattern": "^([0-9a-f]{2})*$"
          },
          "sidecar_hex": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^([0-9a-f]{2})*$"
          }
        }
      }
    },
    "audit": {
      "type": "array",
      "items": {
        "$ref": "audit-event.schema.json#/$defs/recording_integrity_event"
      }
    },
    "audit_complete": {
      "type": "boolean"
    },
    "expected_error": {
      "enum": [
        null,
        "missing_link",
        "missing_notice",
        "invalid_link",
        "invalid_notice",
        "unavailable_pair",
        "invalid_prefix",
        "invalid_chain",
        "incomplete_audit",
        "schema_unavailable"
      ]
    },
    "expected_seq": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "expected_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "expected_evidence_status": {
      "enum": [
        "parsed",
        "unparseable",
        "sidecar_missing"
      ]
    },
    "expected_input_status": {
      "enum": [
        "equal",
        "different",
        "unconfirmed"
      ]
    },
    "expected_output_hex": {
      "type": "string",
      "pattern": "^([0-9a-f]{2})*$"
    }
  },
  "oneOf": [
    {
      "properties": {
        "expected_error": {
          "const": null
        }
      },
      "required": [
        "expected_seq",
        "expected_bytes",
        "expected_evidence_status",
        "expected_input_status"
      ]
    },
    {
      "properties": {
        "expected_error": {
          "enum": [
            "missing_link",
            "missing_notice",
            "invalid_link",
            "invalid_notice",
            "unavailable_pair",
            "invalid_prefix",
            "invalid_chain",
            "incomplete_audit",
            "schema_unavailable"
          ]
        }
      }
    }
  ]
}
