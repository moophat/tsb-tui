{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic vendor password decoder known answer",
  "type": "object",
  "required": [
    "variant",
    "cipher_bytes",
    "outcome"
  ],
  "additionalProperties": false,
  "properties": {
    "variant": {
      "enum": [
        "legacy",
        "02",
        "03",
        "unsupported"
      ]
    },
    "cipher_bytes": {
      "type": "string",
      "minLength": 2,
      "maxLength": 8192,
      "pattern": "^(?:[0-9a-f]{2})+$",
      "description": "Cipher bytes in lower-case hex."
    },
    "outcome": {
      "enum": [
        "readable",
        "unreadable"
      ]
    },
    "plaintext": {
      "const": "FIXTURE-NOT-A-PASSWORD"
    }
  },
  "oneOf": [
    {
      "required": [
        "plaintext"
      ],
      "properties": {
        "outcome": {
          "const": "readable"
        }
      }
    },
    {
      "properties": {
        "outcome": {
          "const": "unreadable"
        },
        "plaintext": false
      }
    }
  ]
}
