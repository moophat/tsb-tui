{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recording continuation provider scenario",
  "description": "Ordered provider actions and observations; provider tests are owed.",
  "type": "object",
  "required": [
    "scenario",
    "steps",
    "expect"
  ],
  "additionalProperties": false,
  "properties": {
    "scenario": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expect": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
